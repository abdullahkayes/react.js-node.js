<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dazzling Shipping - Admin Panel<%= title ? ' | ' + title : '' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .sidebar { min-width: 240px; }
    .nav-link { @apply block px-3 py-2 rounded-lg text-gray-300 hover:bg-gray-800 transition; }
    .nav-link-active { @apply bg-blue-600 text-white; }
  </style>
</head>
<body class="bg-gray-100">
  <% if (user) { %>
  <div class="flex min-h-screen">
    <aside class="sidebar bg-gray-900 text-white p-4">
      <h2 class="text-xl font-bold mb-6">Admin Panel</h2>
      <nav class="space-y-2">
        <a href="/admin" class="nav-link <%= currentPage === 'dashboard' ? 'nav-link-active' : '' %>">Dashboard</a>
        <a href="/admin/shipments" class="nav-link <%= currentPage === 'shipments' ? 'nav-link-active' : '' %>">Shipments</a>
        <a href="/admin/rate-cards" class="nav-link <%= currentPage === 'rate-cards' ? 'nav-link-active' : '' %>">Rate Cards</a>
        <a href="/admin/users" class="nav-link <%= currentPage === 'users' ? 'nav-link-active' : '' %>">Users</a>
      </nav>
      <div class="mt-6 px-3 py-2 text-sm text-gray-400">
        Logged in as: <%= user.email %>
      </div>
      <a href="/admin/logout" class="nav-link mt-2">Logout</a>
    </aside>
    <main class="flex-1 overflow-auto">
      <div class="p-8">
        <%- body %>
      </div>
    </main>
  </div>
  <% } else { %>
    <%- body %>
  <% } %>
</body>
</html>
