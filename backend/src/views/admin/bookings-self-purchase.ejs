<!DOCTYPE html>
<html lang="en" class="h-full bg-[#0b0f19]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Self-Purchase Pre-Alerts - Requests &amp; Bookings - Dazzling Shipping</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              dark: '#0b0f19', card: '#111726', border: '#1e293b',
              orange: '#ff5c00', 'orange-hover': '#e05200',
              accentBlue: '#38bdf8', accentGreen: '#22c55e',
              accentPurple: '#a855f7', accentRed: '#ef4444',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-[#0b0f19] text-gray-200 font-sans antialiased overflow-x-hidden">
  <div class="flex min-h-screen w-full">
    <%- include('partials/sidebar', { active: 'bookings' }) %>

    <div class="flex-1 flex flex-col min-w-0">
      <%- include('partials/header', {
        title: 'Self-Purchase Pre-Alert',
        subtitle: 'Parcels customers are shipping themselves',
        user: typeof user !== 'undefined' ? user : {},
      }) %>

      <main class="flex-1 p-6 space-y-5 overflow-y-auto">
        <%- include('partials/requests-queue') %>
      </main>
    </div>
  </div>
</body>
</html>