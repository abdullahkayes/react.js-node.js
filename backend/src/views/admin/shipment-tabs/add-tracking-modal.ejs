<%
  /* ---------------------------------------------------------------------------
   * Add Tracking Number Modal - Items & Carrier Tracking
   *
   * Opened by the Add Tracking Number button in the header and by the Add
   * Tracking Number link on any Unmatched row. Both are wired to the same
   * hook, so the dialog can be given its own behaviour without touching the
   * tab: the row it is opened from is passed in for the modal to read.
   *
   * The detailed behaviour of this modal - what it collects, what it validates
   * and what it saves - is defined separately. What is here is the shell: it
   * opens and closes like every other dialog on the manage page, and the
   * shipment context it acts on is read from the database rather than typed in.
   * ------------------------------------------------------------------------- */
  const V = (typeof shipment !== 'undefined' && shipment) ? shipment : null;

  const shipmentId = (V && V.shipmentId) ? V.shipmentId : '—';
  const serviceMode = (V && V.serviceMode) || 'Import';
  const freightMode = (V && V.freightMode) ? V.freightMode : null;
  /* Where goods are expected to land depends only on the direction of travel. */
  const expectedFacility = serviceMode === 'Export' ? 'USA Warehouse' : 'Dhaka Hub';
%>

<!-- Popup Modal Backdrop (Hidden by default so it never opens automatically) -->
<div id="addTrackingModal" class="hidden fixed inset-0 z-50 bg-[#020712]/80 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6 overflow-y-auto">

  <!-- Modal Dialog Card -->
  <div class="bg-[#071122] border border-[#182945] rounded-xl shadow-2xl w-full max-w-2xl my-auto overflow-hidden text-slate-200 font-sans text-[11.5px] antialiased">

    <!-- Header Section -->
    <div class="px-6 pt-5 pb-4 border-b border-[#132238] relative">
      <!-- Breadcrumb -->
      <div class="text-[10.5px] text-slate-400 mb-2 font-medium">
        Manage Shipment <span class="mx-1 text-slate-600">/</span> Items &amp; Carrier Tracking <span class="mx-1 text-slate-600">/</span> <span class="text-slate-300">Add Tracking Number</span>
      </div>

      <div class="flex items-start justify-between">
        <div>
          <h2 class="text-xl font-bold text-white tracking-tight">Add Tracking Number</h2>
          <p class="text-[11px] text-slate-400 mt-0.5">Record a carrier or local courier tracking number for this shipment.</p>
        </div>
        <button type="button" data-close-tracking-modal class="text-slate-400 hover:text-white p-1 rounded-lg hover:bg-[#12213a] transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Modal Content Body -->
    <div class="p-6 space-y-5">

      <!-- Shipment Context Banner -->
      <div class="bg-[#050c18] border border-[#13223b] rounded-lg p-3.5 grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
        <div>
          <span class="block text-[10px] text-slate-400 font-medium">Shipment ID</span>
          <span class="text-xs font-bold text-white font-mono mt-0.5 block"><%= shipmentId %></span>
        </div>
        <div>
          <span class="block text-[10px] text-slate-400 font-medium">Expected Facility</span>
          <span class="text-xs font-semibold text-white mt-0.5 block"><%= expectedFacility %></span>
        </div>
        <div>
          <span class="block text-[10px] text-slate-400 font-medium">Service Mode</span>
          <span class="text-xs font-semibold text-white mt-0.5 block"><%= serviceMode %></span>
        </div>
        <div>
          <span class="block text-[10px] text-slate-400 font-medium">Freight Mode</span>
          <span class="text-xs font-semibold text-white mt-0.5 block"><%= freightMode || '—' %></span>
        </div>
      </div>

      <!-- Reference to the row the dialog was opened from, filled when opened -->
      <input type="hidden" id="addTrackingSourceItem" value="" />

      <p class="text-[11px] text-slate-400">
        The detailed behaviour of this dialog is defined separately. Everything it
        needs about this shipment is already loaded above, and the tracking number
        row it was opened from is passed in when it is opened from an Unmatched
        entry.
      </p>

    </div>

    <!-- Modal Action Footer -->
    <div class="px-6 py-4 border-t border-[#132238] flex items-center justify-end gap-2 bg-[#0a142a]">
      <button type="button" data-close-tracking-modal class="px-3.5 py-1.5 bg-[#0e1f3b] hover:bg-[#152a4e] border border-[#22406d] text-slate-300 text-[11px] font-medium rounded transition-colors">
        Cancel
      </button>
      <button type="button" data-close-tracking-modal class="px-3.5 py-1.5 bg-[#f97316] hover:bg-[#ea580c] text-white text-[11px] font-semibold rounded shadow transition-colors">
        Save Tracking Number
      </button>
    </div>

  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('addTrackingModal');
    if (!modal) return;

    window.openAddTrackingModal = function (row) {
      /* A row is only known when the dialog is opened from an Unmatched entry
         in the tracking table. Opening it from the header button passes
         nothing, and the dialog carries no context it does not need. */
      const source = document.getElementById('addTrackingSourceItem');
      if (source) source.value = row && row.number ? row.number : '';
      modal.classList.remove('hidden');
    };

    window.closeAddTrackingModal = function () {
      modal.classList.add('hidden');
      const source = document.getElementById('addTrackingSourceItem');
      if (source) source.value = '';
    };

    document.querySelectorAll('[data-open-tracking-modal]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const rowEl = btn.closest('tr');
        const cell = rowEl ? rowEl.querySelector('.copy-target') : null;
        window.openAddTrackingModal(cell ? { number: cell.textContent.trim() } : null);
      });
    });

    modal.querySelectorAll('[data-close-tracking-modal]').forEach((btn) => {
      btn.addEventListener('click', window.closeAddTrackingModal);
    });

    /* Clicking the backdrop closes the dialog; clicking inside it does not. */
    modal.addEventListener('click', (e) => {
      if (e.target === modal) window.closeAddTrackingModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) window.closeAddTrackingModal();
    });
  })();
</script>
