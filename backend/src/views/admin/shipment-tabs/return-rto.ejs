<%
  /* ---------------------------------------------------------------------------
   * Manage Shipment - Return & RTO Tab
   *
   * Data comes from the shipment view built by renderShipmentManage():
   *   - shipment.serviceMode      (Import | Export)
   *   - shipment.purchaseType     (Self-Purchase | Assisted Purchase | N/A)
   *   - shipment.returnsRTOs[]    (ReturnRTO records with type='return' or 'rto')
   *
   * The ReturnRTO model stores:
   *   type: 'return' | 'rto'
   *   status: initiated | under_review | approved | rejected | in_progress | completed | cancelled
   *   requestedOn, processedOn, updatedAt (timestamps)
   *
   * We split by type and map stored statuses to the display vocabularies.
   * ------------------------------------------------------------------------- */
  const S = (typeof shipment !== 'undefined' && shipment) ? shipment : {};

  const serviceMode = S.serviceMode || 'Import';
  const purchaseType = S.purchaseType || (serviceMode === 'Export' ? 'N/A' : 'Self-Purchase');

  const allRecords = Array.isArray(S.returnsRTOs) ? S.returnsRTOs : [];
  const returns = allRecords.filter((r) => r.type === 'return');
  const rtoCases = allRecords.filter((r) => r.type === 'rto');

  /* Map stored ReturnRTO status -> display status for Return Requests. */
  const returnStatusMap = {
    initiated: 'Draft',
    under_review: 'Under Review',
    approved: 'Approved',
    rejected: 'Rejected',
    in_progress: 'In Transit',
    completed: 'Completed',
    cancelled: 'Cancelled',
  };
  const returnStatus = (raw) => returnStatusMap[String(raw || '').toLowerCase()] || String(raw || '—');

  /* Map stored ReturnRTO status -> display status for RTO cases. */
  const rtoStatusMap = {
    initiated: 'Draft',
    under_review: 'Under Review',
    approved: 'Approved',
    rejected: 'Rejected',
    in_progress: 'In Transit',
    completed: 'Resolved',
    cancelled: 'Closed',
  };
  const rtoStatus = (raw) => rtoStatusMap[String(raw || '').toLowerCase()] || String(raw || '—');

  /* Status badge tones. */
  const RETURN_STATUS_TONE = {
    'Draft': 'bg-slate-500/10 text-slate-300 border-slate-500/20',
    'Under Review': 'bg-amber-500/10 text-amber-400 border-amber-500/20',
    'Approved': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
    'Rejected': 'bg-rose-500/10 text-rose-400 border-rose-500/20',
    'In Transit': 'bg-sky-500/10 text-sky-400 border-sky-500/20',
    'Completed': 'bg-green-500/10 text-green-400 border-green-500/20',
    'Cancelled': 'bg-gray-500/10 text-gray-400 border-gray-500/20',
    'Needs More Information': 'bg-orange-500/10 text-orange-400 border-orange-500/20',
    'Resolved': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
    'Closed': 'bg-gray-500/10 text-gray-400 border-gray-500/20',
  };
  const returnStatusTone = (s) => RETURN_STATUS_TONE[String(s || '')] || RETURN_STATUS_TONE.Draft;
  const rtoStatusTone = (s) => RETURN_STATUS_TONE[String(s || '')] || RETURN_STATUS_TONE.Draft;

  const fmtDate = (v) =>
    v ? new Date(v).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '—';
  const orDash = (v) => v === null || v === undefined || String(v).trim() === '' ? '—' : v;

  /* Build Return Request display ID like "RET-2600142" from numeric id. */
  const returnRef = (id) => 'RET-' + String(id).padStart(7, '0');
  /* Build RTO Case display ID like "RTO-2600081" from numeric id. */
  const rtoRef = (id) => 'RTO-' + String(id).padStart(7, '0');

  /* Item IDs are stored as JSON array in itemIds; format as comma-separated string. */
  const formatItemIds = (arr) => {
    if (!Array.isArray(arr) || !arr.length) return '—';
    return arr.map((x) => String(x)).join(', ');
  };
%>

<div id="return-rto-container" class="space-y-5 text-slate-200 font-sans text-[11.5px] antialiased">

  <!-- Header Section -->
  <div class="space-y-1">
    <h1 class="text-xl font-bold text-white tracking-tight">Return & RTO</h1>
    <p class="text-[11px] text-slate-400">
      View return requests and failed-delivery cases. Open a case to manage it on its dedicated page.
    </p>
    <div class="flex items-center gap-4 pt-0.5 text-[11px] text-slate-300">
      <span>Service Mode: <strong class="text-white font-medium"><%= serviceMode %></strong></span>
      <span>Purchase Type: <strong class="text-white font-medium"><%= purchaseType %></strong></span>
    </div>
  </div>

  <!-- Panel 1: Return Requests -->
  <div class="bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-bold text-white">Return Requests</h2>
      <span class="text-[10.5px] text-slate-400"><%= returns.length %> return request<%= returns.length !== 1 ? 's' : '' %></span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-[#1b2b48] text-slate-400 text-[10.5px]">
            <th class="py-2 pr-2 font-medium">Return Request ID</th>
            <th class="py-2 px-2 font-medium">Item IDs</th>
            <th class="py-2 px-2 font-medium">Status</th>
            <th class="py-2 px-2 font-medium">Submitted</th>
            <th class="py-2 px-2 font-medium">Last Updated</th>
            <th class="py-2 pl-2 text-right font-medium">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#16243d]/60 text-slate-300">
          <% if (!returns.length) { %>
            <tr>
              <td colspan="6" class="py-4 text-center text-slate-400">No return requests for this shipment</td>
            </tr>
          <% } %>
          <% returns.forEach((rec) => { %>
            <tr class="hover:bg-[#0f1d35]/50 transition-colors">
              <td class="py-3 pr-2 font-medium text-white"><%= returnRef(rec.id) %></td>
              <td class="py-3 px-2 text-slate-300"><%= formatItemIds(rec.itemIds) %></td>
              <td class="py-3 px-2">
                <span class="px-2.5 py-0.5 rounded-full <%= returnStatusTone(returnStatus(rec.status)) %> border text-[9.5px] font-medium">
                  <%= returnStatus(rec.status) %>
                </span>
              </td>
              <td class="py-3 px-2 text-slate-300"><%= fmtDate(rec.requestedOn) %></td>
              <td class="py-3 px-2 text-slate-300"><%= fmtDate(rec.updatedAt) %></td>
              <td class="py-3 pl-2 text-right">
                <!-- Not wired: intended to redirect to Return & RTO > Manage Return page. -->
                <a href="#" class="text-blue-400 hover:text-blue-300 hover:underline">Manage Return</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Panel 2: RTO / Failed-Delivery Cases -->
  <div class="bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-sm font-bold text-white">RTO / Failed-Delivery Cases</h2>
      <span class="text-[10.5px] text-slate-400"><%= rtoCases.length %> case<%= rtoCases.length !== 1 ? 's' : '' %></span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-[#1b2b48] text-slate-400 text-[10.5px]">
            <th class="py-2 pr-2 font-medium">RTO Case ID</th>
            <th class="py-2 px-2 font-medium">Case Type</th>
            <th class="py-2 px-2 font-medium">Service Mode</th>
            <th class="py-2 px-2 font-medium">Reason</th>
            <th class="py-2 px-2 font-medium">Status</th>
            <th class="py-2 px-2 font-medium">Last Updated</th>
            <th class="py-2 pl-2 text-right font-medium">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#16243d]/60 text-slate-300">
          <% if (!rtoCases.length) { %>
            <tr>
              <td colspan="7" class="py-4 text-center text-slate-400">No RTO or failed-delivery cases for this shipment</td>
            </tr>
          <% } %>
          <% rtoCases.forEach((rec) => { %>
            <tr class="hover:bg-[#0f1d35]/50 transition-colors">
              <td class="py-3 pr-2 font-medium text-white"><%= rtoRef(rec.id) %></td>
              <td class="py-3 px-2 text-slate-300"><%= rec.reason || 'RTO' %></td>
              <td class="py-3 px-2 text-slate-300"><%= orDash(rec.serviceMode) %></td>
              <td class="py-3 px-2 text-slate-300"><%= orDash(rec.reason) %></td>
              <td class="py-3 px-2">
                <span class="px-2.5 py-0.5 rounded-full <%= rtoStatusTone(rtoStatus(rec.status)) %> border text-[9.5px] font-medium">
                  <%= rtoStatus(rec.status) %>
                </span>
              </td>
              <td class="py-3 px-2 text-slate-300"><%= fmtDate(rec.updatedAt) %></td>
              <td class="py-3 pl-2 text-right">
                <!-- Not wired: intended to redirect to Return & RTO > Manage RTO page. -->
                <a href="#" class="text-blue-400 hover:text-blue-300 hover:underline">Manage RTO</a>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</div>