<%
  /*
    Manage Shipment - Overview tab.
    The section body that ships inline on first render and is swapped
    back in whenever the Overview tab is clicked. The header banner and
    the tab strip live in shipment-manage.ejs and stay visible.
  */
  const itemCount = shipment && shipment.items ? shipment.items.length : 0;
%>

<!-- Action Required Banner Callout -->
<div class="bg-[#2a1308] border border-[#7c2d12] rounded px-4 py-2 flex items-center justify-between flex-wrap gap-2 text-[12px]">
  <div class="text-[#fdba74] flex items-center gap-1.5">
    <span class="font-semibold text-white">Action required:</span>
    <span>Review the supporting document for Item ID <span class="font-mono text-white">ITM-2605534</span> before approving this shipment.</span>
  </div>
  <span class="px-2 py-0.5 bg-[#451a03] border border-[#9a3412] text-[#f97316] text-[10px] font-semibold uppercase tracking-wider rounded">
    Item review pending
  </span>
</div>

<!-- Key Metadata 4-Card Summary Bar -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
  <div class="bg-[#0b1426] border border-[#1b2b48] rounded p-3">
    <div class="text-[10px] text-slate-400 font-medium">Service Mode</div>
    <div class="text-base font-bold text-white mt-1"><%= shipment.serviceMode || 'Import' %></div>
  </div>
  <div class="bg-[#0b1426] border border-[#1b2b48] rounded p-3">
    <div class="text-[10px] text-slate-400 font-medium">Purchase Type</div>
    <div class="text-base font-bold text-white mt-1"><%= shipment.purchaseType || 'Self Purchase' %></div>
  </div>
  <div class="bg-[#0b1426] border border-[#1b2b48] rounded p-3">
    <div class="text-[10px] text-slate-400 font-medium">Freight Mode</div>
    <div class="text-base font-bold text-white mt-1"><%= shipment.freightMode || 'Sea' %></div>
  </div>
  <div class="bg-[#0b1426] border border-[#1b2b48] rounded p-3">
    <div class="text-[10px] text-slate-400 font-medium">Customer</div>
    <div class="text-base font-bold text-white mt-1 truncate">
      <span class="text-blue-400 font-mono"><%= shipment.user?.customerCode || 'CUS-2600089' %></span>
      <span class="text-slate-400 mx-1">•</span>
      <span><%= shipment.user?.name || 'Rahman Imports Ltd.' %></span>
    </div>
  </div>
</div>

<!-- Main Grid Body Layout -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

  <!-- Left Column (8 Columns Wide) -->
  <div class="lg:col-span-8 space-y-4">

    <!-- Shipment Overview Box -->
    <div class="bg-[#0b1426] border border-[#1b2b48] rounded p-4">
      <div class="flex items-center justify-between pb-3 border-b border-[#16243d]">
        <h2 class="text-sm font-bold text-white">Shipment Overview</h2>
        <button type="button" class="px-2.5 py-1 bg-[#12213a] border border-[#20365c] hover:bg-[#182c4d] text-slate-200 text-[11px] font-medium rounded">
          Edit Shipment
        </button>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-y-3 gap-x-4 pt-3 text-[11px]">
        <div>
          <span class="text-slate-400 block">Shipment ID</span>
          <span class="text-white font-medium"><%= shipment.shipmentId || 'SHP-2602844' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Dazzling Tracking Number</span>
          <span class="text-white font-medium"><%= shipment.trackingNumber || 'DS-2602844' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Origin</span>
          <span class="text-white font-medium"><%= shipment.origin || 'USA' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Destination</span>
          <span class="text-white font-medium"><%= shipment.destination || 'Bangladesh' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Origin Facility</span>
          <span class="text-white font-medium"><%= shipment.originFacility || 'USA Warehouse' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Destination Facility</span>
          <span class="text-white font-medium"><%= shipment.destinationFacility || 'Dhaka Hub' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Total Items</span>
          <span class="text-white font-medium"><%= itemCount || 12 %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Item Type</span>
          <span class="text-white font-medium"><%= shipment.itemType || 'Product / Goods' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Total Declared Shipment Value</span>
          <span class="text-white font-medium"><%= money(shipment.declaredValue || 18900.00, 'USD') %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Insurance Requested</span>
          <span class="text-white font-medium"><%= shipment.insuranceRequested ? 'Yes' : 'Yes' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Declared Weight</span>
          <span class="text-white font-medium"><%= shipment.declaredWeight ? `${shipment.declaredWeight} kg` : '478.5 kg' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Actual Weight</span>
          <span class="text-white font-medium"><%= shipment.actualWeight ? `${shipment.actualWeight} kg` : '480.8 kg' %></span>
        </div>
        <div>
          <span class="text-slate-400 block">Chargeable Weight</span>
          <span class="text-white font-medium"><%= shipment.weightKg ? `${shipment.weightKg} kg` : '486.0 kg' %></span>
        </div>
      </div>
    </div>

  </div>

  <!-- Right Column (4 Columns Wide) -->
  <div class="lg:col-span-4 space-y-4">

    <!-- Customer & Contact Box -->
    <div class="bg-[#0b1426] border border-[#1b2b48] rounded p-4">
      <h2 class="text-sm font-bold text-white pb-3 border-b border-[#16243d]">Customer & Contact</h2>
      <div class="space-y-2 pt-3 text-[11px]">
        <div class="flex justify-between">
          <span class="text-slate-400">Customer</span>
          <span class="text-white font-medium text-right"><%= shipment.user?.name || 'Rahman Imports Limited' %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Customer ID</span>
          <span class="text-white font-mono font-medium"><%= shipment.user?.customerCode || 'CUS-2600089' %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Customer Type</span>
          <span class="text-white font-medium"><%= shipment.user?.customerType || 'Commercial' %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Email</span>
          <a href="mailto:<%= shipment.user?.email || 'info@rahmanimports.com' %>" class="text-blue-400 hover:underline truncate max-w-[180px] text-right"><%= shipment.user?.email || 'info@rahmanimports.com' %></a>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Phone</span>
          <span class="text-white font-medium"><%= shipment.user?.phone || '+880 1977-112233' %></span>
        </div>
      </div>
    </div>

    <!-- Final Delivery Instructions Box -->
    <div class="bg-[#0b1426] border border-[#1b2b48] rounded p-4">
      <h2 class="text-sm font-bold text-white pb-3 border-b border-[#16243d]">Final Delivery Instructions</h2>
      <div class="space-y-2.5 pt-3 text-[11px]">
        <div>
          <span class="text-slate-400 block">Final Delivery Method</span>
          <span class="text-white font-medium">Customer Instruction</span>
        </div>
        <div>
          <span class="text-slate-400 block">Delivery Address</span>
          <span class="text-white font-medium">Warehouse 3, 18 Tongi Industrial Area, Gazipur 1710, Bangladesh</span>
        </div>
        <div class="border-l-2 border-[#f97316] pl-2.5 py-1 bg-[#121c2e] rounded-r">
          <span class="text-white font-semibold block mb-0.5">Customer Instructions</span>
          <p class="text-slate-300 text-[10.5px] leading-relaxed">
            Contact the receiving manager before dispatch. Deliver on a weekday between 10:00 AM and 4:00 PM using a covered vehicle.
          </p>
        </div>
      </div>
    </div>

    <!-- Review Summary Box -->
    <div class="bg-[#0b1426] border border-[#1b2b48] rounded p-4">
      <h2 class="text-sm font-bold text-white pb-3 border-b border-[#16243d]">Review Summary</h2>
      <div class="space-y-2.5 pt-3 text-[11px]">
        <div class="flex items-center justify-between">
          <span class="text-slate-400">Item Acceptance</span>
          <span class="px-2 py-0.5 bg-[#451a03] text-[#f97316] border border-[#9a3412] text-[10px] font-semibold rounded-full">
            1 pending review
          </span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Documents</span>
          <span class="text-white font-medium">4 uploaded • 3 verified</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Quotation</span>
          <span class="text-white font-medium">Not yet issued</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Payment</span>
          <span class="text-white font-medium">Not yet due</span>
        </div>
      </div>
    </div>

  </div>

</div>
