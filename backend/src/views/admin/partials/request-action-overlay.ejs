<%
  /*
    Shows the two Request Processing pages over the details page, without leaving it.

    The overlay fetches the page it displays rather than keeping a second copy of
    the markup, so the standalone page and the overlay can never disagree: there is
    one template per action. The trigger is still a real link to that page, so with
    scripting unavailable the button navigates there exactly as before, and a
    middle-click or "open in new tab" reaches it too.

    The overlay supplies its own header, so it hides the page's own breadcrumb and
    heading - those carry data-page-chrome in the page templates.
  */
%>
<div data-overlay-root>

  <div data-overlay="review-acceptance" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-start sm:items-center justify-center p-2 sm:p-4 overflow-y-auto">
    <div class="w-full max-w-5xl bg-[#0b0f19] border border-[#1a2333] rounded-2xl shadow-2xl flex flex-col max-h-[94vh] my-auto">

      <div class="px-5 py-3.5 border-b border-[#1a2333] flex items-center justify-between gap-4 shrink-0">
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-9 h-9 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center shrink-0">
            <i data-lucide="clipboard-check" class="w-5 h-5"></i>
          </span>
          <div class="min-w-0">
            <h2 class="text-sm font-bold text-white leading-tight">Review Item Acceptance</h2>
            <p class="text-[11px] text-gray-400 mt-0.5 truncate"><%= type.label %> &bull; <%= row.requestRef %></p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a data-overlay-standalone href="<%= acceptanceReviewHref %>" target="_blank" rel="noopener" title="Open as a full page" class="px-2.5 py-1.5 border border-[#1a2333] rounded-lg text-[11px] text-gray-400 hover:text-white hover:bg-[#111726] transition-colors flex items-center gap-1.5">
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Full page
          </a>
          <button type="button" data-overlay-close title="Close" class="text-gray-400 hover:text-white p-1.5 rounded-lg hover:bg-[#111726] transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <div data-overlay-body class="overflow-y-auto flex-1">
        <div data-overlay-loading class="py-16 text-center text-gray-500 text-xs">
          <i data-lucide="loader-2" class="w-5 h-5 mx-auto mb-2 animate-spin"></i>
          Loading&hellip;
        </div>
        <div data-overlay-content class="hidden"></div>
        <div data-overlay-error class="hidden py-16 text-center text-xs">
          <i data-lucide="alert-circle" class="w-5 h-5 mx-auto mb-2 text-rose-400"></i>
          <p data-overlay-error-text class="text-rose-300"></p>
          <a data-overlay-standalone href="<%= acceptanceReviewHref %>" class="inline-flex items-center gap-1.5 mt-3 text-sky-400 hover:underline">
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>Open the full page instead
          </a>
        </div>
      </div>
    </div>
  </div>

  <div data-overlay="information" class="hidden fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-start sm:items-center justify-center p-2 sm:p-4 overflow-y-auto">
    <div class="w-full max-w-5xl bg-[#0b0f19] border border-[#1a2333] rounded-2xl shadow-2xl flex flex-col max-h-[94vh] my-auto">

      <div class="px-5 py-3.5 border-b border-[#1a2333] flex items-center justify-between gap-4 shrink-0">
        <div class="flex items-center gap-3 min-w-0">
          <span class="w-9 h-9 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center shrink-0">
            <i data-lucide="message-square-warning" class="w-5 h-5"></i>
          </span>
          <div class="min-w-0">
            <h2 class="text-sm font-bold text-white leading-tight">Request Information</h2>
            <p class="text-[11px] text-gray-400 mt-0.5 truncate"><%= type.label %> &bull; <%= row.requestRef %></p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <a data-overlay-standalone href="<%= informationFormHref %>" target="_blank" rel="noopener" title="Open as a full page" class="px-2.5 py-1.5 border border-[#1a2333] rounded-lg text-[11px] text-gray-400 hover:text-white hover:bg-[#111726] transition-colors flex items-center gap-1.5">
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Full page
          </a>
          <button type="button" data-overlay-close title="Close" class="text-gray-400 hover:text-white p-1.5 rounded-lg hover:bg-[#111726] transition-colors">
            <i data-lucide="x" class="w-4 h-4"></i>
          </button>
        </div>
      </div>

      <div data-overlay-body class="overflow-y-auto flex-1">
        <div data-overlay-loading class="py-16 text-center text-gray-500 text-xs">
          <i data-lucide="loader-2" class="w-5 h-5 mx-auto mb-2 animate-spin"></i>
          Loading&hellip;
        </div>
        <div data-overlay-content class="hidden"></div>
        <div data-overlay-error class="hidden py-16 text-center text-xs">
          <i data-lucide="alert-circle" class="w-5 h-5 mx-auto mb-2 text-rose-400"></i>
          <p data-overlay-error-text class="text-rose-300"></p>
          <a data-overlay-standalone href="<%= informationFormHref %>" class="inline-flex items-center gap-1.5 mt-3 text-sky-400 hover:underline">
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>Open the full page instead
          </a>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  (function () {
    'use strict';

    var root = document.querySelector('[data-overlay-root]');
    if (!root) return;

    // Guarded so a second include on one page cannot bind the handlers twice.
    if (window.__requestOverlayBound) return;
    window.__requestOverlayBound = true;

    var detailsHref = <%- JSON.stringify(detailsHref) %>;

    function show(node) { node.classList.remove('hidden'); }
    function hide(node) { node.classList.add('hidden'); }

    function panelOf(name) {
      return root.querySelector('[data-overlay="' + name + '"]');
    }

    function open(name) {
      var panel = panelOf(name);
      if (!panel) return;

      var body = panel.querySelector('[data-overlay-body]');
      var loading = panel.querySelector('[data-overlay-loading]');
      var content = panel.querySelector('[data-overlay-content]');
      var errorBox = panel.querySelector('[data-overlay-error]');

      show(panel);
      show(loading);
      hide(content);
      hide(errorBox);
      content.innerHTML = '';
      document.body.style.overflow = 'hidden';
      if (window.lucide) lucide.createIcons();

      var href = panel.querySelector('[data-overlay-standalone]').getAttribute('href');

      fetch(href, { headers: { 'X-Requested-With': 'fetch' } })
        .then(function (response) {
          if (!response.ok) throw new Error('The page returned HTTP ' + response.status + '.');
          return response.text();
        })
        .then(function (html) {
          var parsed = new DOMParser().parseFromString(html, 'text/html');
          var main = parsed.querySelector('main');
          if (!main) throw new Error('The page did not contain any content.');

          var mounted = document.importNode(main, true);

          // The page supplies its own chrome; the overlay has a header already.
          mounted.setAttribute('data-overlay-page', 'true');
          mounted.classList.remove('overflow-y-auto');
          mounted.querySelectorAll('[data-page-chrome]').forEach(function (node) { node.remove(); });

          content.innerHTML = '';
          content.appendChild(mounted);

          // Imported scripts do not run, so each one is recreated. That is what
          // makes the page's own validation and decision handling work in here
          // exactly as it does on the standalone page.
          //
          // Only the scripts in the body are replayed: the ones in the head are the
          // icon set, the Tailwind CDN and its config, and this page has already
          // loaded all of those.
          parsed.querySelectorAll('body script').forEach(function (original) {
            if (original.src) return;

            var script = document.createElement('script');
            // Every attribute is copied, not just the type: the page's own script
            // finds its data blocks by their data-* attributes, so losing those
            // would leave it running with an empty catalogue.
            [].slice.call(original.attributes).forEach(function (attribute) {
              script.setAttribute(attribute.name, attribute.value);
            });
            script.textContent = original.textContent;
            content.appendChild(script);
          });

          hide(loading);
          show(content);
          if (window.lucide) lucide.createIcons();
        })
        .catch(function (problem) {
          hide(loading);
          panel.querySelector('[data-overlay-error-text]').textContent =
            problem.message + ' Open it as a full page instead.';
          show(errorBox);
          if (window.lucide) lucide.createIcons();
        });
    }

    function close(panel) {
      if (!panel) return;
      // Clearing the content tears down the page's state with it, so reopening
      // starts from a clean form rather than the last one filled in.
      panel.querySelector('[data-overlay-content]').innerHTML = '';
      hide(panel);
      if (!root.querySelector('[data-overlay]:not(.hidden)')) document.body.style.overflow = '';
    }

    document.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-overlay-open]');
      if (trigger) {
        event.preventDefault();
        open(trigger.getAttribute('data-overlay-open'));
        return;
      }

      if (event.target.closest('[data-overlay-close]')) {
        close(event.target.closest('[data-overlay]'));
        return;
      }

      // A click on the backdrop itself closes the overlay.
      if (event.target.hasAttribute && event.target.hasAttribute('data-overlay')) {
        close(event.target);
        return;
      }

      // "Back to Request" inside the mounted page means close the overlay, not
      // reload the details page the reader is already on.
      var back = event.target.closest('a[href]');
      if (back && back.getAttribute('href') === detailsHref) {
        event.preventDefault();
        close(event.target.closest('[data-overlay]'));
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      var openPanel = root.querySelector('[data-overlay]:not(.hidden)');
      if (openPanel) close(openPanel);
    });
  })();
</script>