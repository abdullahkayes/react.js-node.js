<%
  /* Rate cards.

    The shell used to be a light-theme page with a hand-written four-link sidebar
    and no top bar. It now uses the shared partials, so it carries the same
    sidebar, top bar, icon set and fonts as every other admin page and can no
    longer drift from them.
  */
  // The three selects and the two money inputs are identical in both forms, so
  // they are declared once rather than pasted twice.
  const ZONES = ['domestic', 'regional', 'international'];
  const SERVICES = ['standard', 'express', 'priority'];
  const FIELD = 'bg-[#0e1420] border border-[#1a2333] focus:border-orange-500 rounded-lg px-3 py-2 text-xs text-gray-200 placeholder-gray-500 outline-none';
  const SUBMIT = 'px-4 py-2 bg-[#ff5c00] hover:bg-[#e05200] text-white text-xs font-medium rounded-lg transition-colors';

  const zoneOptions = (selected) => ZONES.map((z) =>
    `<option value="${z}" ${z === selected ? 'selected' : ''}>${z.charAt(0).toUpperCase() + z.slice(1)}</option>`).join('');
  const serviceOptions = (selected) => SERVICES.map((s) =>
    `<option value="${s}" ${s === selected ? 'selected' : ''}>${s.charAt(0).toUpperCase() + s.slice(1)}</option>`).join('');
%>
<%- include('partials/head', { pageTitle: 'Rate Cards - Dazzling Shipping', active: 'freight' }) %>

<%- include('partials/header', {
  title: 'Rate Cards',
  subtitle: 'Pricing used to quote and bill shipments',
  user: typeof user !== 'undefined' ? user : {},
}) %>

<main class="flex-1 p-6 space-y-5 overflow-y-auto">

  <!-- Add -->
  <div class="bg-[#111726] border border-[#1a2333] rounded-xl p-5">
    <h3 class="text-sm font-bold text-white mb-4">Add New Rate Card</h3>
    <form method="POST" action="/admin/rate-cards" class="grid grid-cols-1 md:grid-cols-7 gap-3 items-end">
      <select name="originZone" class="<%= FIELD %>" required><%- zoneOptions('domestic') %></select>
      <select name="destinationZone" class="<%= FIELD %>" required><%- zoneOptions('domestic') %></select>
      <select name="serviceType" class="<%= FIELD %>" required><%- serviceOptions('standard') %></select>
      <input type="number" step="0.01" name="pricePerKg" placeholder="Price/kg" class="<%= FIELD %>" required />
      <input type="number" step="0.01" name="baseFee" placeholder="Base fee" class="<%= FIELD %>" required />
      <input type="text" name="currency" placeholder="Currency" defaultValue="USD" class="<%= FIELD %> w-20" required />
      <button type="submit" class="<%= SUBMIT %>">Add</button>
    </form>
  </div>

  <!-- List -->
  <div class="bg-[#111726] border border-[#1a2333] rounded-xl overflow-x-auto">
    <table class="w-full">
      <thead class="bg-[#0e1420]">
        <tr class="text-gray-400 text-[11px] font-semibold uppercase tracking-wider">
          <th class="px-4 py-3 text-left">Origin Zone</th>
          <th class="px-4 py-3 text-left">Dest Zone</th>
          <th class="px-4 py-3 text-left">Service</th>
          <th class="px-4 py-3 text-left">Price/kg</th>
          <th class="px-4 py-3 text-left">Base Fee</th>
          <th class="px-4 py-3 text-left">Currency</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#1a2333]/60 text-gray-200 text-xs">
        <% if (!rateCards.length) { %>
          <tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">No rate cards yet.</td></tr>
        <% } %>
        <% rateCards.forEach(rc => { %>
        <tr class="hover:bg-[#0f172a] transition-colors">
          <td class="px-4 py-3"><%= rc.originZone %></td>
          <td class="px-4 py-3"><%= rc.destinationZone %></td>
          <td class="px-4 py-3"><%= rc.serviceType %></td>
          <td class="px-4 py-3"><%= rc.pricePerKg %></td>
          <td class="px-4 py-3"><%= rc.baseFee %></td>
          <td class="px-4 py-3"><%= rc.currency %></td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <a href="/admin/rate-cards?edit=<%= rc.id %>" class="text-[#ff5c00] hover:text-[#e05200] font-medium hover:underline">Edit</a>
            <form method="POST" action="/admin/rate-cards/<%= rc.id %>/delete" class="inline">
              <button type="submit" class="text-[#ef4444] hover:text-red-300 font-medium hover:underline ml-3"
                      onclick="return confirm('Delete this rate card?')">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Edit, only when a card is being edited -->
  <% if (editing) { %>
  <div class="bg-[#111726] border border-[#1a2333] rounded-xl p-5">
    <h3 class="text-sm font-bold text-white mb-4">Edit Rate Card #<%= editing.id %></h3>
    <form method="POST" action="/admin/rate-cards/<%= editing.id %>/edit" class="grid grid-cols-1 md:grid-cols-7 gap-3 items-end">
      <select name="originZone" class="<%= FIELD %>" required><%- zoneOptions(editing.originZone) %></select>
      <select name="destinationZone" class="<%= FIELD %>" required><%- zoneOptions(editing.destinationZone) %></select>
      <select name="serviceType" class="<%= FIELD %>" required><%- serviceOptions(editing.serviceType) %></select>
      <input type="number" step="0.01" name="pricePerKg" placeholder="Price/kg" value="<%= editing.pricePerKg %>" class="<%= FIELD %>" required />
      <input type="number" step="0.01" name="baseFee" placeholder="Base fee" value="<%= editing.baseFee %>" class="<%= FIELD %>" required />
      <input type="text" name="currency" placeholder="Currency" value="<%= editing.currency %>" class="<%= FIELD %> w-20" required />
      <button type="submit" class="<%= SUBMIT %>">Save</button>
    </form>
  </div>
  <% } %>
</main>

<script>
  if (window.lucide) lucide.createIcons();
</script>
</body>
</html>