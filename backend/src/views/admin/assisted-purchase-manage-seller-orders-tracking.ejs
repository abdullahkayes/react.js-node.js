<!DOCTYPE html>
<html lang="en" class="h-full bg-[#050c18]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Seller Orders & Tracking - SHP-2602847 - Dazzling Shipping</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              dark: '#050c18', card: '#081225', border: '#1b2b48',
              orange: '#f97316', 'orange-hover': '#ea580c',
              accentBlue: '#38bdf8', accentGreen: '#22c55e',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-[#050c18] text-slate-200 font-sans antialiased overflow-x-hidden">
  <div class="flex min-h-screen w-full">
    <%- include('partials/sidebar', { active: 'assisted-purchase' }) %>
    
    <div class="flex-1 flex flex-col min-w-0">
      <%- include('partials/header', { 
        title: 'Manage Purchase', 
        subtitle: 'Coordinate the approved purchase and follow seller orders', 
        user: typeof user !== 'undefined' ? user : {} 
      }) %>

      <main class="flex-1 p-6 space-y-5 overflow-y-auto">
        <%
          /* ---------------------------------------------------------------------------
           * Seller Orders & Tracking Context & Data Setup
           * ------------------------------------------------------------------------- */
          const shipmentId = (typeof purchase !== 'undefined' && purchase.shipmentId) ? purchase.shipmentId : 'SHP-2602847';
          const subtitle = 'Record purchases and track seller parcels';

          const sellerOrders = (typeof orders !== 'undefined' && Array.isArray(orders)) ? orders : [
            {
              orderNumber: '113-8472600-0912456',
              store: 'Amazon',
              purchasedAt: '07 Sep 2026\n10:45 AM',
              linkedItemsText: 'ITM-260847-01 - 20 units\nITM-260847-02 - 10 units',
              trackings: [
                { carrier: 'UPS', number: '1Z84A32E0392284721', itemQty: 'ITM-260847-01 - 20 units' },
                { carrier: 'USPS', number: '9400111899562137483091', itemQty: 'ITM-260847-02 - 10 units' }
              ],
              orderTotal: 'USD 467.60',
              recordedBy: 'STF-260018',
              selected: true
            }
          ];

          const selectedOrder = sellerOrders.find(o => o.selected) || sellerOrders[0];

          const linkedPurchases = [
            { id: 'ITM-260847-01', product: 'Cotton T-shirt', requestedQty: 20, purchasedQty: 20 },
            { id: 'ITM-260847-02', product: 'Moisturizing cream', requestedQty: 10, purchasedQty: 10 },
            { id: 'ITM-260847-03', product: 'Wireless headphones', requestedQty: 4, purchasedQty: 0 },
            { id: 'ITM-260847-04', product: 'Running shoes', requestedQty: 2, purchasedQty: 0 }
          ];
        %>

        <!-- Top Breadcrumb & Title Section -->
        <div class="flex items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="text-[10.5px] text-slate-400 font-medium">
              <a href="/admin/assisted-purchases" class="hover:underline">Assisted Purchase &amp; Procurement</a> 
              <span class="mx-1 text-slate-600">/</span> 
              <span class="text-slate-300">Manage Purchase</span>
            </div>

            <div class="flex items-center gap-3 pt-0.5">
              <h1 class="text-xl font-bold text-white tracking-tight font-mono"><%= shipmentId %></h1>
              <span class="text-slate-400 text-[11px]">• &nbsp;<%= subtitle %> </span>
            </div>
          </div>

          <button type="button" class="px-3.5 py-1.5 bg-[#f97316] hover:bg-[#ea580c] text-white text-[11px] font-semibold rounded shadow transition-colors shrink-0">
            Record Seller Order 
          </button>
        </div>

        <!-- Section Sub-Tabs Navigation Strip -->
        <div class="border-b border-[#1b2b48] flex items-center gap-6 text-[11.5px] font-medium pt-1">
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Overview</a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/items-purchase-preparation" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Items &amp; Purchase Preparation</a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/invoice-advance-payment" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Invoice &amp; Advance Payment</a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/seller-orders-tracking" class="pb-2.5 text-[#f97316] border-b-2 border-[#f97316] font-semibold">Seller Orders &amp; Tracking </a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/documents" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Documents</a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/audit-trail" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Audit Trail</a>
        </div>

        <!-- Seller Orders Table Panel -->
        <div class="bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-3">
          <div class="border-b border-[#132238] pb-2.5">
            <h2 class="text-xs font-bold text-white uppercase tracking-wider">Seller Orders </h2>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-[11px]">
              <thead>
                <tr class="border-b border-[#1b2b48] text-slate-400 text-[10px]">
                  <th class="py-2.5 pr-3 font-semibold">Seller Order Number </th>
                  <th class="py-2.5 px-3 font-semibold">Store / Website Name </th>
                  <th class="py-2.5 px-3 font-semibold">Purchased At </th>
                  <th class="py-2.5 px-3 font-semibold">Linked Items </th>
                  <th class="py-2.5 px-3 font-semibold">Carrier / Local Courier Tracking Numbers </th>
                  <th class="py-2.5 px-3 font-semibold">Order Total </th>
                  <th class="py-2.5 px-3 font-semibold">Recorded By </th>
                  <th class="py-2.5 pl-3 text-right font-semibold">Action </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#16243d]/60 text-slate-300">
                <% sellerOrders.forEach((order) => { %>
                  <tr class="hover:bg-[#0f1d35]/50 transition-colors <%= order.selected ? 'bg-[#0e1d38]/40' : '' %>">
                    
                    <!-- Order Number -->
                    <td class="py-3.5 pr-3 font-mono font-medium text-white align-top">
                      <%= order.orderNumber %> 
                    </td>

                    <!-- Store -->
                    <td class="py-3.5 px-3 text-slate-200 font-medium align-top">
                      <%= order.store %> 
                    </td>

                    <!-- Purchased At -->
                    <td class="py-3.5 px-3 text-slate-400 whitespace-pre-line text-[10.5px] leading-snug align-top">
                      <%= order.purchasedAt %> 
                    </td>

                    <!-- Linked Items -->
                    <td class="py-3.5 px-3 font-mono text-[10.5px] text-slate-300 whitespace-pre-line leading-relaxed align-top">
                      <%= order.linkedItemsText %> 
                    </td>

                    <!-- Trackings list -->
                    <td class="py-3.5 px-3 align-top space-y-2">
                      <% order.trackings.forEach((trk) => { %>
                        <div>
                          <div class="font-bold text-white text-[10.5px]"><%= trk.carrier %> </div>
                          <div class="flex items-center gap-1.5 font-mono text-slate-200 text-[10.5px]">
                            <span><%= trk.number %> </span>
                            <button type="button" class="text-blue-400 hover:underline text-[10px]" onclick="navigator.clipboard.writeText('<%= trk.number %>')">Copy </button>
                          </div>
                          <div class="font-mono text-slate-400 text-[9.5px]"><%= trk.itemQty %> </div>
                        </div>
                      <% }); %>
                    </td>

                    <!-- Order Total -->
                    <td class="py-3.5 px-3 font-mono font-semibold text-white align-top">
                      <%= order.orderTotal %> 
                    </td>

                    <!-- Recorded By -->
                    <td class="py-3.5 px-3 font-mono text-blue-400 align-top">
                      <%= order.recordedBy %> 
                    </td>

                    <!-- Action Link -->
                    <td class="py-3.5 pl-3 text-right align-top">
                      <a href="#" class="text-blue-400 hover:underline font-medium text-[11px]">View / Edit Order </a>
                    </td>

                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Selected Seller Order & Linked Items 2-Column Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          
          <!-- LEFT COLUMN: Selected Seller Order Details (6 Cols) -->
          <div class="lg:col-span-6 bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-4">
            <div class="border-b border-[#132238] pb-2.5">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider">Selected Seller Order </h3>
            </div>

            <div class="grid grid-cols-2 gap-y-3.5 gap-x-4 text-[11px]">
              <div>
                <span class="text-[10px] text-slate-400 block">Seller Order Number </span>
                <span class="font-mono text-white mt-0.5 block font-semibold"><%= selectedOrder.orderNumber %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Store / Website Name </span>
                <span class="text-slate-200 mt-0.5 block font-medium"><%= selectedOrder.store %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Product Subtotal </span>
                <span class="font-mono text-slate-200 mt-0.5 block font-medium">USD 420.00 </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Sales Tax </span>
                <span class="font-mono text-slate-200 mt-0.5 block font-medium">USD 33.60 </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Domestic Shipping </span>
                <span class="font-mono text-slate-200 mt-0.5 block font-medium">USD 14.00 </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Actual Seller Order Total </span>
                <span class="font-mono font-bold text-white mt-0.5 block">USD 467.60 </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Purchased By </span>
                <span class="text-slate-200 mt-0.5 block font-medium">USA partner </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Recorded By </span>
                <a href="#" class="text-blue-400 hover:underline font-mono mt-0.5 block"><%= selectedOrder.recordedBy %> </a>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Order Receipt </span>
                <a href="#" class="text-blue-400 hover:underline mt-0.5 block font-mono">amazon-order-receipt.pdf </a>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Order Confirmation </span>
                <a href="#" class="text-blue-400 hover:underline mt-0.5 block font-mono">amazon-order-confirmation.pdf </a>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Estimated Warehouse Arrival </span>
                <span class="text-slate-200 mt-0.5 block font-medium">11 Sep 2026 </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Receiving Facility </span>
                <span class="text-slate-200 mt-0.5 block font-medium">USA Warehouse </span>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Linked Items & Remaining Purchases (6 Cols) -->
          <div class="lg:col-span-6 bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-4">
            <div class="border-b border-[#132238] pb-2.5">
              <h3 class="text-xs font-bold text-white uppercase tracking-wider">Linked Items &amp; Remaining Purchases </h3>
            </div>

            <div class="overflow-x-auto border border-[#13223b] rounded">
              <table class="w-full text-left border-collapse text-[11px]">
                <thead>
                  <tr class="bg-[#050c18] border-b border-[#13223b] text-slate-400 text-[10px]">
                    <th class="py-2 px-3 font-semibold">Item ID </th>
                    <th class="py-2 px-3 font-semibold">Product </th>
                    <th class="py-2 px-3 font-semibold text-center">Requested Qty </th>
                    <th class="py-2 px-3 font-semibold text-center">Purchased Qty </th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-[#13223b]/60 text-slate-300">
                  <% linkedPurchases.forEach((item) => { %>
                    <tr class="hover:bg-[#0f1d35]/50 transition-colors">
                      <td class="py-2.5 px-3 font-mono text-blue-400 font-medium"><%= item.id %> </td>
                      <td class="py-2.5 px-3 font-medium text-white"><%= item.product %> </td>
                      <td class="py-2.5 px-3 text-center text-slate-300"><%= item.requestedQty %> </td>
                      <td class="py-2.5 px-3 text-center font-bold text-white"><%= item.purchasedQty %> </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>

            <div class="text-[10.5px] text-slate-400 pt-1">
              2 of 4 items purchased. Walmart items remain to be purchased. 
            </div>
          </div>

        </div>

        <!-- Developer Reference Footer Box -->
        <div class="bg-[#050c18] border border-dashed border-[#1b2b48] rounded-md p-3.5 text-[11px] text-slate-400 space-y-1">
          <div class="text-slate-300 font-semibold">Developer reference — outside the live tab </div>
          <p class="text-[10.5px] leading-relaxed">
            Recorded-tracking example. Record Seller Order may be saved before the store supplies tracking; show "Not yet provided" in that row until available. View / Edit Order opens the seller order form, including repeatable carrier tracking entries with carrier, tracking number, linked Item IDs and quantities, and estimated arrival. One order may have several tracking numbers, and one parcel may contain several items. Save updates to the existing shipment and internal pre-alert without creating a new customer request. Keep edit history and prevent duplicate parcel records or excess linked quantities. Any existing Add Carrier Tracking Number shortcut opens this same order editor at its tracking fields. Authorized staff record the USA partner's information; warehouse receipt is confirmed in Warehouse & Hub Operations. 
          </p>
        </div>

      </main>
    </div>
  </div>

  <script>
    if (window.lucide) lucide.createIcons();
  </script>
</body>
</html>