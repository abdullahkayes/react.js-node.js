<%
  /* Users list.

    The shell used to be a light-theme page with a hand-written four-link sidebar
    and no top bar. It now uses the shared partials, so it carries the same
    sidebar, top bar, icon set and fonts as every other admin page and can no
    longer drift from them.
  */
%>
<%- include('partials/head', { pageTitle: 'Users - Dazzling Shipping', active: 'users' }) %>

<%- include('partials/header', {
  title: 'Users',
  subtitle: 'Accounts, roles and access across the ERP',
  user: typeof user !== 'undefined' ? user : {},
}) %>

<main class="flex-1 p-6 overflow-y-auto">
  <div class="bg-[#111726] border border-[#1a2333] rounded-xl overflow-x-auto">
    <table class="w-full">
      <thead class="bg-[#0e1420]">
        <tr class="text-gray-400 text-[11px] font-semibold uppercase tracking-wider">
          <th class="px-4 py-3 text-left">#</th>
          <th class="px-4 py-3 text-left">Name</th>
          <th class="px-4 py-3 text-left">Email</th>
          <th class="px-4 py-3 text-left">Phone</th>
          <th class="px-4 py-3 text-left">Role</th>
          <th class="px-4 py-3 text-left">Created</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[#1a2333]/60 text-gray-200 text-xs">
        <% if (!users.length) { %>
          <tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">No users yet.</td></tr>
        <% } %>
        <% users.forEach(u => { %>
        <tr class="hover:bg-[#0f172a] transition-colors">
          <td class="px-4 py-3 text-gray-400"><%= u.id %></td>
          <td class="px-4 py-3 font-medium text-gray-100"><%= u.name %></td>
          <td class="px-4 py-3 text-gray-400"><%= u.email %></td>
          <td class="px-4 py-3 text-gray-400"><%= u.phone || '—' %></td>
          <td class="px-4 py-3">
            <form method="POST" action="/admin/users/<%= u.id %>/role" class="flex gap-2">
              <select name="role" class="bg-[#0e1420] border border-[#1a2333] focus:border-orange-500 rounded px-2 py-1 text-[11px] text-gray-200 outline-none">
                <option value="customer" <%= u.role === 'customer' ? 'selected' : '' %>>Customer</option>
                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                <option value="staff" <%= u.role === 'staff' ? 'selected' : '' %>>Staff</option>
              </select>
              <button type="submit" class="px-2 py-1 bg-[#ff5c00] hover:bg-[#e05200] text-white rounded text-[11px] font-medium transition-colors">Update</button>
            </form>
          </td>
          <td class="px-4 py-3 text-gray-400"><%= new Date(u.createdAt).toLocaleDateString() %></td>
          <td class="px-4 py-3 text-right">
            <a href="/admin/users/<%= u.id %>" class="text-[#ff5c00] hover:text-[#e05200] font-medium hover:underline">View</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</main>

<script>
  if (window.lucide) lucide.createIcons();
</script>
</body>
</html>