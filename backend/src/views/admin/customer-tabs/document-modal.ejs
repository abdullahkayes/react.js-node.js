<!--
  Document verification popup.

  Markup only - behaviour lives in customer-detail.ejs because inline <script>
  tags do not run when this partial is injected via AJAX tab switching, and the
  modal has to keep working after a tab partial is swapped in.

  The structure is universal for every document type; what the reviewer checks
  is not. The checklist list is therefore rendered at open time from the
  catalogue embedded below (config/documentChecklists.js), which is the same
  definition the save endpoint scores the decision against.

  Values are filled from data-* attributes on the triggering "Open File"
  element (see data-doc-field lookups in the shell script).
-->

<!--
  Checklist catalogue. Rendered as JSON rather than inline JavaScript so it can
  be read back from a partial that was injected with innerHTML.
-->
<script type="application/json" data-checklist-catalog><%- JSON.stringify(typeof documentChecklists !== 'undefined' ? documentChecklists : { common: [], groups: [] }) %></script>

<!-- Backdrop -->
<div id="docModalBackdrop" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-2 sm:p-4 overflow-y-auto">
  <div class="bg-[#f8fafc] w-full max-w-7xl rounded-xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[96vh]">

    <!-- Header -->
    <div class="bg-white px-5 py-3.5 border-b border-slate-200 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-200 flex items-center justify-center text-blue-600 shrink-0">
          <i data-lucide="file-check" class="w-5 h-5"></i>
        </div>
        <div>
          <h2 class="text-base font-bold text-slate-900 tracking-tight leading-none">Document Verification</h2>
          <p class="text-[11px] text-slate-500 mt-1">Review the document, complete the applicable checks and record your decision. Viewing a document does not change its status.</p>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button type="button" data-doc-action="close" title="Close" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
    </div>

    <!-- Body -->
    <div class="p-4 overflow-y-auto grid grid-cols-1 lg:grid-cols-12 gap-4 bg-[#f1f5f9]/50">

      <!-- ================= LEFT COLUMN ================= -->
      <div class="lg:col-span-5 space-y-4">

        <!-- Document Information: read-only, loaded from the database -->
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          <div class="bg-[#f8fafc] px-4 py-2.5 border-b border-slate-200 flex items-center gap-2">
            <i data-lucide="file-text" class="w-4 h-4 text-blue-600"></i>
            <h3 class="text-xs font-bold text-slate-800">Document Information</h3>
          </div>
          <div class="p-4 text-xs space-y-2.5">
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Customer ID</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 font-mono font-semibold text-slate-800 break-all" data-doc-field="customerId">-</span>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Customer Name</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 font-semibold text-slate-800" data-doc-field="customerName">-</span>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Document ID</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 font-mono text-slate-700" data-doc-field="docId">-</span>
            </div>
            <div class="grid grid-cols-12 gap-2 items-center">
              <span class="col-span-4 text-slate-500 font-medium">Document Type</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <div class="col-span-7">
                <span class="inline-block bg-blue-100/70 text-blue-700 font-medium px-2 py-0.5 rounded text-[11px]" data-doc-field="docType">-</span>
              </div>
            </div>
            <div class="grid grid-cols-12 gap-2 items-center">
              <span class="col-span-4 text-slate-500 font-medium">Current Status</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <div class="col-span-7">
                <span class="inline-block bg-amber-100 text-amber-800 font-medium px-2 py-0.5 rounded text-[11px]" data-doc-field="status">-</span>
              </div>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">File Name</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 font-mono text-slate-700 truncate" data-doc-field="fileName" title="-">-</span>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">File Size</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 font-mono text-slate-700" data-doc-field="fileSize">-</span>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Uploaded By</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 font-mono text-slate-700" data-doc-field="uploadedBy">-</span>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Upload Date &amp; Time</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 text-slate-700" data-doc-field="uploadedAt">-</span>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Expiry Date</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 text-slate-700" data-doc-field="expiry">-</span>
            </div>
          </div>
        </div>

        <!-- Related Record: a search field, not a dropdown -->
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          <div class="bg-[#f8fafc] px-4 py-2.5 border-b border-slate-200 flex items-center gap-2">
            <i data-lucide="link-2" class="w-4 h-4 text-blue-600"></i>
            <h3 class="text-xs font-bold text-slate-800">Related Record</h3>
          </div>
          <div class="p-4 text-xs space-y-3">
            <p class="text-[11px] text-slate-500 leading-relaxed">
              Link this document to the record it belongs to. Search by identifier or any record information -
              customer account, request, shipment, claim, return/RTO, payment, invoice.
            </p>

            <div class="relative">
              <input
                type="search"
                data-related-search
                autocomplete="off"
                placeholder="Search by ID or record information (e.g. CUST-1, REQ-2026-..., SHP-..., RTO-3, INV-...)"
                class="w-full pl-3 pr-9 py-2 text-xs border border-slate-300 rounded-md focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 placeholder:text-slate-400 bg-white"
              />
              <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute right-2.5 top-2.5 pointer-events-none"></i>
            </div>

            <!-- Results list, populated by the search -->
            <div data-related-results class="hidden max-h-44 overflow-y-auto border border-slate-200 rounded-md divide-y divide-slate-100"></div>
            <p data-related-hint class="hidden text-[11px] text-slate-400">No matching record found. Refine the search, or save without changing the current related record.</p>

            <!-- Current selection -->
            <div data-related-selected class="hidden bg-blue-50/60 border border-blue-200 rounded-md p-2.5 flex items-center justify-between gap-2">
              <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-7 h-7 rounded bg-blue-600 flex items-center justify-center text-white shrink-0">
                  <i data-lucide="building-2" class="w-4 h-4"></i>
                </div>
                <div class="min-w-0">
                  <div class="font-bold text-blue-950 font-mono leading-tight truncate" data-related-ref>-</div>
                  <div class="text-[11px] text-slate-600 font-medium truncate" data-related-name>-</div>
                </div>
              </div>
              <button type="button" data-related-clear title="Clear related record" class="text-slate-400 hover:text-slate-600 p-1 rounded hover:bg-white/70 transition-colors shrink-0">
                <i data-lucide="x" class="w-4 h-4"></i>
              </button>
            </div>

            <p class="text-[11px] text-slate-400 pt-1">The selected record is stored with this verification. You can change or clear it.</p>
          </div>
        </div>

        <!-- Verification Checklist: dynamic by document type -->
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          <div class="bg-[#f8fafc] px-4 py-2.5 border-b border-slate-200 flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
              <i data-lucide="archive" class="w-4 h-4 text-blue-600 shrink-0"></i>
              <h3 class="text-xs font-bold text-slate-800 truncate">Verification Checklist</h3>
            </div>
            <span class="text-xs font-bold text-emerald-600 shrink-0"><span data-checklist-total>0</span>/<span data-checklist-total-all>0</span> <span class="font-normal text-slate-500">required</span></span>
          </div>

          <div class="px-4 py-2 bg-slate-50 border-b border-slate-100">
            <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
              <div class="bg-emerald-500 h-1.5 rounded-full transition-all" style="width: 0%;" data-checklist-bar></div>
            </div>
            <p class="text-[11px] text-slate-500 mt-2">
              Checks for <span class="font-semibold text-slate-700" data-checklist-type>-</span>. Review the document and complete every required check.
            </p>
          </div>

          <div class="p-4 space-y-4 text-xs">
            <!-- Common checks -->
            <div class="space-y-2.5">
              <div class="flex items-center justify-between font-bold text-slate-800">
                <div class="flex items-center gap-1.5">
                  <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                  <span>Common Checks (<span data-checklist-group="common">0/0</span>)</span>
                </div>
              </div>
              <div class="space-y-2 pl-1" data-checklist-list="common"></div>
            </div>

            <hr class="border-slate-200" />

            <!-- Document-type-specific checks -->
            <div class="space-y-2.5">
              <div class="flex items-center justify-between font-bold text-slate-800">
                <div class="flex items-center gap-1.5 min-w-0">
                  <i data-lucide="check-circle" class="w-4 h-4 text-blue-600"></i>
                  <span class="truncate" data-checklist-title>-</span>
                  <span class="font-normal text-slate-500 shrink-0">(<span data-checklist-group="specific">0/0</span>)</span>
                </div>
              </div>
              <div class="space-y-2 pl-1" data-checklist-list="specific"></div>
            </div>
          </div>
        </div>

      </div>

      <!-- ================= RIGHT COLUMN ================= -->
      <div class="lg:col-span-7 space-y-4">

        <!-- Document Preview -->
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          <div class="bg-[#f8fafc] px-4 py-2.5 border-b border-slate-200 flex items-center gap-2">
            <i data-lucide="eye" class="w-4 h-4 text-blue-600"></i>
            <h3 class="text-xs font-bold text-slate-800">Document Preview</h3>
          </div>

          <div class="p-3 bg-slate-100/60 space-y-3">
            <div class="bg-[#323639] rounded-md overflow-hidden shadow-md flex items-center justify-center min-h-[260px] p-3">
              <img data-preview-img class="hidden max-h-[420px] w-auto mx-auto" alt="Document preview" />
              <iframe data-preview-frame class="hidden w-full h-[420px] bg-white rounded" title="Document preview"></iframe>
              <div data-preview-empty class="text-center text-slate-400 py-10 px-4">
                <i data-lucide="file-question" class="w-8 h-8 mx-auto mb-2"></i>
                <p class="text-xs">No preview available for this file.</p>
                <p class="text-[11px] mt-1">Open the document to view it in a new tab.</p>
              </div>
            </div>

            <div class="flex items-center gap-3 pt-1">
              <a data-preview-open href="#" target="_blank" rel="noopener" class="px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-md text-xs font-semibold flex items-center gap-1.5 shadow-sm shrink-0 transition-colors">
                <span>Open Document</span>
                <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
              </a>
              <p class="text-[11px] text-slate-500 leading-tight">
                The document will open in a new tab. Opening or viewing it does not change its verification status - you must save a decision explicitly.
              </p>
            </div>
          </div>
        </div>

        <!-- Verification Decision -->
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          <div class="bg-[#f8fafc] px-4 py-2.5 border-b border-slate-200 flex items-center gap-2">
            <i data-lucide="gavel" class="w-4 h-4 text-blue-600"></i>
            <h3 class="text-xs font-bold text-slate-800">Verification Decision</h3>
          </div>

          <form data-doc-form class="p-4 space-y-4 text-xs" autocomplete="off">
            <div>
              <label class="block text-xs font-bold text-slate-800 mb-2">Verification Decision <span class="text-red-500">*</span></label>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <label data-decision-option="Verified" class="border border-slate-200 rounded-lg p-2.5 flex items-start gap-2 cursor-pointer hover:border-slate-300 transition-colors">
                  <input type="radio" name="verification_decision" value="Verified" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                  <div>
                    <div class="font-bold text-slate-800 text-xs">Verified</div>
                    <div class="text-[10px] text-slate-400 leading-tight mt-0.5" data-decision-hint="Verified">Complete all required checks to select.</div>
                  </div>
                </label>
                <label data-decision-option="Needs Correction" class="border border-slate-200 rounded-lg p-2.5 flex items-start gap-2 cursor-pointer hover:border-slate-300 transition-colors">
                  <input type="radio" name="verification_decision" value="Needs Correction" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                  <div>
                    <div class="font-bold text-slate-800 text-xs">Needs Correction</div>
                    <div class="text-[10px] text-slate-400 leading-tight mt-0.5">Ask the customer to correct and resubmit.</div>
                  </div>
                </label>
                <label data-decision-option="Rejected" class="border border-slate-200 rounded-lg p-2.5 flex items-start gap-2 cursor-pointer hover:border-slate-300 transition-colors">
                  <input type="radio" name="verification_decision" value="Rejected" class="mt-0.5 text-blue-600 focus:ring-blue-500" />
                  <div>
                    <div class="font-bold text-slate-800 text-xs">Rejected</div>
                    <div class="text-[10px] text-slate-400 leading-tight mt-0.5">Reject the document outright.</div>
                  </div>
                </label>
              </div>
            </div>

            <!-- Verification Note -->
            <div>
              <label class="block text-[11px] font-bold text-slate-800 mb-1">
                Verification Note
                <span class="font-normal text-slate-500" data-note-optional>(Optional for Verified, required for Rejected)</span>
              </label>
              <div class="relative">
                <textarea name="note" rows="2" maxlength="500" placeholder="Record your verification explanation for this document." class="w-full p-2.5 text-xs border border-slate-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 placeholder:text-slate-400 bg-white"></textarea>
                <span class="absolute right-2 bottom-1.5 text-[10px] text-slate-400"><span data-count-for="note">0</span>/500</span>
              </div>
            </div>

            <!-- Correction details: only relevant for "Needs Correction" -->
            <div data-correction-box class="hidden border border-rose-200 bg-rose-50/40 rounded-lg p-3 space-y-3">
              <div class="flex items-center gap-1.5 text-xs font-bold text-rose-700">
                <i data-lucide="info" class="w-4 h-4 text-rose-600"></i>
                <span>Correction Details <span class="font-normal text-rose-600/80">(Required for Needs Correction)</span></span>
              </div>

              <div>
                <label class="block text-[11px] font-bold text-slate-800 mb-1">Problem with Document <span class="text-red-500">*</span></label>
                <div class="relative">
                  <textarea name="problem" rows="2" maxlength="500" placeholder="Describe what is wrong with the document (e.g. unclear, missing information, expired, mismatch, etc.)." class="w-full p-2.5 text-xs border border-slate-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 placeholder:text-slate-400 bg-white"></textarea>
                  <span class="absolute right-2 bottom-1.5 text-[10px] text-slate-400"><span data-count-for="problem">0</span>/500</span>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-bold text-slate-800 mb-1">Correction Required <span class="text-red-500">*</span></label>
                <div class="relative">
                  <textarea name="correction" rows="2" maxlength="500" placeholder="Clearly state what the customer needs to correct or provide (e.g. upload a clear copy, provide the missing page, submit a valid document, etc.)." class="w-full p-2.5 text-xs border border-slate-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 placeholder:text-slate-400 bg-white"></textarea>
                  <span class="absolute right-2 bottom-1.5 text-[10px] text-slate-400"><span data-count-for="correction">0</span>/500</span>
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-bold text-slate-800 mb-1">Additional Instructions <span class="font-normal text-slate-500">(Optional)</span></label>
                <div class="relative">
                  <textarea name="instructions" rows="2" maxlength="500" placeholder="Add any additional guidance for the customer." class="w-full p-2.5 text-xs border border-slate-300 rounded-md focus:ring-1 focus:ring-blue-500 focus:border-blue-500 placeholder:text-slate-400 bg-white"></textarea>
                  <span class="absolute right-2 bottom-1.5 text-[10px] text-slate-400"><span data-count-for="instructions">0</span>/500</span>
                </div>
              </div>
            </div>
          </form>
        </div>

        <!-- Customer Notification Preview -->
        <div data-notify-box class="hidden bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          <div class="bg-[#f8fafc] px-4 py-2.5 border-b border-slate-200 flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <i data-lucide="mail" class="w-4 h-4 text-blue-600"></i>
              <h3 class="text-xs font-bold text-slate-800">Customer Notification (Preview)</h3>
            </div>
            <span class="text-[11px] text-slate-500 text-right">Sent to the customer when you save, and stored with this verification.</span>
          </div>

          <div class="p-4 text-xs space-y-2">
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-2 font-bold text-slate-700">Subject</span>
              <span class="col-span-10 text-slate-800 font-medium" data-notify-subject>-</span>
            </div>
            <div class="grid grid-cols-12 gap-2 pt-1">
              <span class="col-span-2 font-bold text-slate-700">Message</span>
              <pre data-notify-message class="col-span-10 bg-slate-100/70 border border-slate-200 rounded-md p-3 text-slate-600 text-[11px] leading-relaxed font-sans whitespace-pre-wrap"></pre>
            </div>
          </div>
        </div>

        <!-- Verification Record -->
        <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
          <div class="bg-[#f8fafc] px-4 py-2.5 border-b border-slate-200 flex items-center gap-2">
            <i data-lucide="user-check" class="w-4 h-4 text-blue-600"></i>
            <h3 class="text-xs font-bold text-slate-800">Verification Record</h3>
          </div>
          <div class="p-4 text-xs space-y-2">
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Verifying Staff</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 font-semibold text-slate-800" data-verify-staff><%= typeof user !== 'undefined' && user ? (user.name || 'Current staff') : 'Current staff' %></span>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Verification Date &amp; Time</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 text-slate-500 italic">Recorded automatically on save</span>
            </div>
            <div class="grid grid-cols-12 gap-2">
              <span class="col-span-4 text-slate-500 font-medium">Audit Trail</span>
              <span class="col-span-1 text-slate-400 text-center">:</span>
              <span class="col-span-7 text-slate-500 italic">Recorded automatically on save</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Footer -->
    <div class="bg-white px-5 py-3 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center gap-3 shrink-0">
      <p data-doc-error class="hidden flex-1 text-xs text-rose-600 leading-tight"></p>
      <div class="flex items-center justify-end gap-2.5 sm:ml-auto">
        <button type="button" data-doc-action="close" class="px-4 py-2 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-md transition-colors shadow-xs">
          Cancel
        </button>
        <button type="button" data-doc-action="save" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-md transition-colors flex items-center gap-2 shadow-sm">
          <i data-lucide="save" class="w-3.5 h-3.5"></i>
          <span>Save Verification</span>
        </button>
      </div>
    </div>

  </div>
</div>