<!DOCTYPE html>
<html lang="en" class="h-full bg-[#0b0f19]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Staff & Roles - Dazzling Shipping</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              dark: '#0b0f19', card: '#111726', border: '#1e293b',
              orange: '#ff5c00', 'orange-hover': '#e05200',
              accentBlue: '#38bdf8', accentGreen: '#22c55e',
              accentPurple: '#a855f7', accentRed: '#ef4444',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-[#0b0f19] text-gray-200 font-sans antialiased overflow-x-hidden">
  <div class="flex min-h-screen w-full">
    <%- include('partials/sidebar', { active: 'staff' }) %>
    <div class="flex-1 flex flex-col min-w-0">
      <%- include('partials/header', { title: 'Staff & Roles', subtitle: 'Manage staff members and roles', user: typeof user !== 'undefined' ? user : {} }) %>
      <main class="flex-1 p-6 space-y-6 overflow-y-auto">
        <div class="bg-[#111726] border border-[#1a2333] p-6 rounded-xl">
          <h3 class="text-sm font-semibold text-white mb-4">Staff Management</h3>
          <p class="text-gray-400 text-sm">Manage staff members, assign roles, and control access permissions.</p>
        </div>
      </main>
    </div>
  </div>
  <script>if (window.lucide) lucide.createIcons();</script>
</body>
</html>
