<!DOCTYPE html>
<html lang="en" class="h-full bg-[#0b0f19]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Customers & Accounts - Dazzling Shipping</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              dark: '#0b0f19', card: '#111726', border: '#1e293b',
              orange: '#ff5c00', 'orange-hover': '#e05200',
              accentBlue: '#38bdf8', accentGreen: '#22c55e',
              accentPurple: '#a855f7', accentRed: '#ef4444',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-[#0b0f19] text-gray-200 font-sans antialiased overflow-x-hidden">
  <div class="flex flex-col md:flex-row min-h-screen w-full">
    <%- include('partials/sidebar', { active: 'customers' }) %>
    <div class="flex-1 flex flex-col min-w-0">
      <%- include('partials/header', { title: 'Customers & Accounts', subtitle: 'Manage customer profiles and accounts', user: typeof user !== 'undefined' ? user : {} }) %>
      <main class="flex-1 p-3 sm:p-4 md:p-6 space-y-6 overflow-y-auto">
        
        <!-- Summary Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5" id="summaryCards">
          <% const cards = [
            { key: '', label: 'Total Customers', count: summaryCards.total, icon: 'users', color: 'sky' },
            { key: 'Active', label: 'Active Accounts', count: summaryCards.active, icon: 'user-check', color: 'emerald' },
            { key: 'Warning', label: 'Warning Accounts', count: summaryCards.warning, icon: 'alert-triangle', color: 'amber' },
            { key: 'Restricted', label: 'Restricted Accounts', count: summaryCards.restricted, icon: 'lock', color: 'rose' },
            { key: 'Suspended', label: 'Suspended Accounts', count: summaryCards.suspended, icon: 'user-x', color: 'purple' },
            { key: 'Terminated', label: 'Terminated Accounts', count: summaryCards.terminated, icon: 'ban', color: 'red' },
            { key: 'Closed', label: 'Closed Accounts', count: summaryCards.closed, icon: 'archive-x', color: 'gray' },
            { key: 'Dormant', label: 'Dormant Accounts', count: summaryCards.dormant, icon: 'moon', color: 'blue' },
            { key: 'newThisMonth', label: 'New This Month', count: summaryCards.newThisMonth, icon: 'calendar-plus', color: 'cyan' }
          ]; %>
          <% cards.forEach(card => { %>
            <div
              class="bg-[#111726] border border-[#1a2333] p-4 rounded-xl flex items-center justify-between hover:border-<%= card.color %>-500/40 transition-colors cursor-pointer group"
              onclick="filterTable('<%= card.key %>')"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg border border-<%= card.color %>-500/30 bg-<%= card.color %>-500/10 flex items-center justify-center text-<%= card.color %>-400 shrink-0">
                  <i data-lucide="<%= card.icon %>" class="w-4 h-4"></i>
                </div>
                <div>
                  <p class="text-[11px] text-gray-400 font-medium"><%= card.label %></p>
                  <p class="text-xl font-bold text-<%= card.color %>-400"><%= card.count %></p>
                </div>
              </div>
              <i data-lucide="arrow-right" class="w-4 h-4 text-gray-500 opacity-0 group-hover:opacity-100 transition-opacity"></i>
            </div>
          <% }) %>
        </div>

        <!-- Filters Row -->
        <div class="p-3 sm:p-4 border border-[#162238] rounded-xl bg-[#080e1b] flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5 w-full">
            
              <!-- Search Box -->
              <div class="relative w-full sm:w-auto sm:flex-1 sm:min-w-[240px] max-w-full">
                <i data-lucide="search" class="w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500"></i>
                <input 
                  type="text" 
                  id="filterSearch"
                  value="<%= search %>"
                  placeholder="Search by Customer ID, name, business, email or phone" 
                  class="w-full bg-[#0b1120] border border-[#162238] rounded-lg pl-9 pr-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-[#f95700] transition-colors"
                />
              </div>

              <!-- Customer Type Dropdown -->
              <div class="relative w-full sm:w-auto">
                <select id="filterType" class="w-full appearance-none bg-[#0b1120] border border-[#162238] rounded-lg pl-3 pr-8 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-[#f95700] cursor-pointer">
                  <option value="all" <%= type === 'all' ? 'selected' : '' %>>Customer Type: All</option>
                  <% customerTypes.forEach(t => { %>
                    <option value="<%= t %>" <%= type === t ? 'selected' : '' %>><%= t %></option>
                  <% }) %>
                </select>
                <i data-lucide="chevron-down" class="w-3 h-3 text-slate-400 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
              </div>

              <!-- Account Status Dropdown -->
              <div class="relative w-full sm:w-auto">
                <select id="filterStatus" class="w-full appearance-none bg-[#0b1120] border border-[#162238] rounded-lg pl-3 pr-8 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-[#f95700] cursor-pointer">
                  <option value="" <%= filter ? '' : 'selected' %>>Account Status: All</option>
                  <% accountStatuses.forEach(s => { %>
                    <option value="<%= s %>" <%= filter === s ? 'selected' : '' %>><%= s %></option>
                  <% }) %>
                </select>
                <i data-lucide="chevron-down" class="w-3 h-3 text-slate-400 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
              </div>

              <!-- Verification Dropdown -->
              <div class="relative w-full sm:w-auto">
                <select id="filterVerification" class="w-full appearance-none bg-[#0b1120] border border-[#162238] rounded-lg pl-3 pr-8 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-[#f95700] cursor-pointer">
                  <option value="all" <%= verification === 'all' ? 'selected' : '' %>>Verification: All</option>
                  <% verificationStatuses.forEach(v => { %>
                    <option value="<%= v %>" <%= verification === v ? 'selected' : '' %>><%= v %></option>
                  <% }) %>
                </select>
                <i data-lucide="chevron-down" class="w-3 h-3 text-slate-400 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
              </div>

              <!-- Last Activity Dropdown -->
              <div class="relative w-full sm:w-auto">
                <select id="filterActivity" class="w-full appearance-none bg-[#0b1120] border border-[#162238] rounded-lg pl-3 pr-8 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-[#f95700] cursor-pointer">
                  <% activityOptions.forEach(opt => { %>
                    <option value="<%= opt %>" <%= activity === opt ? 'selected' : '' %>><%= opt.charAt(0).toUpperCase() + opt.slice(1) %></option>
                  <% }) %>
                </select>
                <i data-lucide="chevron-down" class="w-3 h-3 text-slate-400 absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
              </div>

              <!-- Reset Filters Button -->
              <button type="button" onclick="resetFilters()" class="w-full sm:w-auto px-3 py-1.5 rounded-lg border border-[#162238] bg-[#0b1120] hover:bg-[#111a2e] text-xs font-medium text-slate-300 transition-colors">
                Reset Filters
              </button>
            </div>
          </div>

        <!-- Table Toolbar -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
          <div class="relative w-full sm:w-80">
            <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input
              type="text"
              placeholder="Search by name or email..."
              class="w-full bg-[#111726] border border-[#1e293b] rounded-lg pl-10 pr-3 py-2 text-xs text-gray-200 placeholder-gray-500 focus:outline-none focus:border-orange-500 transition-colors"
              onkeyup="handleSearch(this.value)"
            />
          </div>
          <button
            onclick="exportPDF()"
            class="flex items-center justify-center gap-2 px-4 py-2 bg-orange-500 text-white rounded-lg text-xs font-medium hover:bg-orange-600 transition-colors shadow-md shadow-orange-500/20"
          >
            <i data-lucide="file-down" class="w-4 h-4"></i>
            Export List (PDF)
          </button>
        </div>

        <!-- Main Table Container with Top Scrollbar -->
        <div class="bg-[#111726] border border-[#1a2333] rounded-xl overflow-x-auto [transform:rotateX(180deg)]">
          <div class="[transform:rotateX(180deg)]">
            <table class="w-full text-left border-collapse text-xs min-w-[900px]">
              <thead>
                <tr class="text-gray-400 border-b border-[#1a2333]">
                  <th class="pb-3 px-4 font-medium">Customer ID</th>
                  <th class="pb-3 px-4 font-medium">Name</th>
                  <th class="pb-3 px-4 font-medium">Email</th>
                  <th class="pb-3 px-4 font-medium">Phone</th>
                  <th class="pb-3 px-4 font-medium">Account Type</th>
                  <th class="pb-3 px-4 font-medium">Verification</th>
                  <th class="pb-3 px-4 font-medium">Account Status</th>
                  <th class="pb-3 px-4 font-medium">Total Shipments</th>
                  <th class="pb-3 px-4 font-medium">Created</th>
                  <th class="pb-3 px-4 text-right font-medium">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#1a2333]/60">
                <% if (customers && customers.length > 0) { %>
                  <% customers.forEach(c => { %>
                    <tr class="hover:bg-[#0e1320]/50 transition-colors">
                      <td class="py-3 px-4 relative">
                        <a href="/admin/customers/<%= c.id %>" class="font-mono text-sky-400 hover:text-sky-300 relative group underline decoration-sky-400/30 hover:decoration-sky-300">#<%= c.id %></a>
                        <div class="absolute hidden group-hover:block z-20 w-64 p-3 left-4 top-full mt-1 bg-[#111726] border border-[#1e293b] rounded-lg shadow-xl text-xs text-gray-300 pointer-events-none">
                          <div class="space-y-1">
                            <div><span class="text-gray-400">Name:</span> <%= c.name %></div>
                            <div><span class="text-gray-400">Email:</span> <%= c.email %></div>
                            <div><span class="text-gray-400">Phone:</span> <%= c.phone || 'N/A' %></div>
                            <div><span class="text-gray-400">Status:</span> <%= c.accountStatus %></div>
                            <div><span class="text-gray-400">Account Type:</span> <%= c.account_type ? c.account_type.replace(/_/g, ' ') : 'N/A' %></div>
                            <div><span class="text-gray-400">WhatsApp:</span> <%= c.whatsapp || 'N/A' %></div>
                            <div><span class="text-gray-400">Shipments:</span> <%= c.shipmentCount %></div>
                          </div>
                        </div>
                      </td>
                      <td class="py-3 px-4 text-gray-200 font-medium whitespace-nowrap"><%= c.name %></td>
                      <td class="py-3 px-4 text-gray-300 whitespace-nowrap"><%= c.email %></td>
                      <td class="py-3 px-4 text-gray-300 whitespace-nowrap"><%= c.phone || 'N/A' %></td>
                      <td class="py-3 px-4 text-gray-300 whitespace-nowrap"><%= c.account_type ? c.account_type.replace(/_/g, ' ') : 'N/A' %></td>
                      <td class="py-3 px-4 whitespace-nowrap">
                        <%
                          const verified = [c.emailVerificationStatus, c.phoneVerificationStatus].includes('Verified');
                          const pending = [c.emailVerificationStatus, c.phoneVerificationStatus].includes('Pending');
                          const vLabel = verified ? 'Verified' : pending ? 'Pending' : 'Not Required';
                          const vCls = verified
                            ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                            : pending
                              ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
                              : 'bg-gray-500/10 text-gray-400 border border-gray-500/20';
                        %>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-medium <%= vCls %>"><%= vLabel %></span>
                      </td>
                      <td class="py-3 px-4 whitespace-nowrap">
                        <% const st = String(c.accountStatus || '').toLowerCase(); %>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-medium
                          <%= st === 'active' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' :
                             st === 'warning' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' :
                             st === 'restricted' ? 'bg-rose-500/10 text-rose-400 border border-rose-500/20' :
                             st === 'suspended' ? 'bg-purple-500/10 text-purple-400 border border-purple-500/20' :
                             st === 'closed' ? 'bg-gray-500/10 text-gray-400 border border-gray-500/20' :
                             st === 'dormant' ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' :
                             st === 'terminated' ? 'bg-red-500/10 text-red-400 border border-red-500/20' :
                             'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' %>">
                          <%= c.accountStatus %>
                        </span>
                      </td>
                      <td class="py-3 px-4 text-gray-300 whitespace-nowrap"><%= c.shipmentCount %></td>
                      <td class="py-3 px-4 text-gray-400 whitespace-nowrap"><%= new Date(c.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></td>
                      <td class="py-3 px-4 text-right whitespace-nowrap">
                        <button type="button" onclick="viewDetails('<%= c.id %>')" class="px-3 py-1 text-xs border border-[#1e293b] text-gray-300 rounded hover:bg-[#1e293b]/50 transition-colors">View Details</button>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="10" class="py-8 px-4 text-center text-gray-500">
                      <% if (search || filter || type !== 'all' || verification !== 'all' || activity !== 'any') { %>
                        No customers match the selected filters.
                      <% } else { %>
                        No customers found.
                      <% } %>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Pagination -->
        <% const totalPages = Math.max(1, Math.ceil(total / pageSize)); %>
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-400">
          <p class="text-center sm:text-left">
            Showing <span class="text-gray-200 font-semibold"><%= total === 0 ? 0 : (currentPage - 1) * pageSize + 1 %></span>–<span class="text-gray-200 font-semibold"><%= Math.min(currentPage * pageSize, total) %></span>
            of <span class="text-gray-200 font-semibold"><%= total %></span> customer<%= total === 1 ? '' : 's' %>
          </p>
          <% if (totalPages > 1) { %>
            <div class="flex items-center gap-1.5">
              <% const qs = new URLSearchParams(Object.fromEntries(
                    Object.entries({ search, filter, type, verification, activity }).filter(([, v]) => v && v !== 'all' && v !== 'any')
                  )); %>
              <% if (currentPage > 1) { %>
                <a href="?<%= qs.toString() ? qs.toString() + '&' : '' %>page=<%= currentPage - 1 %>" class="px-2.5 py-1 rounded-lg border border-[#1e293b] hover:bg-[#1e293b]/50 transition-colors">Previous</a>
              <% } %>
              <span class="px-2.5 py-1 rounded-lg bg-[#0b1120] border border-[#1e293b] text-gray-200"><%= currentPage %> / <%= totalPages %></span>
              <% if (currentPage < totalPages) { %>
                <a href="?<%= qs.toString() ? qs.toString() + '&' : '' %>page=<%= currentPage + 1 %>" class="px-2.5 py-1 rounded-lg border border-[#1e293b] hover:bg-[#1e293b]/50 transition-colors">Next</a>
              <% } %>
            </div>
          <% } %>
        </div>
      </main>
    </div>
  </div>
  <script>
    if (window.lucide) lucide.createIcons();

    // Every filter control below writes to the same query string, so the page
    // always reloads straight from the database with the selected filters.
    function applyFilters(extra) {
      const params = new URLSearchParams(window.location.search);
      const set = (key, value, fallback) => {
        if (!value || value === fallback) params.delete(key);
        else params.set(key, value);
      };
      set('search', document.getElementById('filterSearch')?.value.trim(), '');
      set('filter', document.getElementById('filterStatus')?.value, '');
      set('type', document.getElementById('filterType')?.value, 'all');
      set('verification', document.getElementById('filterVerification')?.value, 'all');
      set('activity', document.getElementById('filterActivity')?.value, 'any');
      Object.entries(extra || {}).forEach(([k, v]) => set(k, v, ''));
      params.set('page', '1');
      window.location.search = params.toString();
    }

    function resetFilters() {
      window.location.search = '';
    }

    document.getElementById('filterSearch')?.addEventListener('input', function () {
      clearTimeout(window._filterSearchTimeout);
      window._filterSearchTimeout = setTimeout(() => applyFilters(), 500);
    });
    ['filterStatus', 'filterType', 'filterVerification', 'filterActivity'].forEach(id => {
      document.getElementById(id)?.addEventListener('change', () => applyFilters());
    });

    function filterTable(status) {
      const params = new URLSearchParams(window.location.search);
      if (status && status !== 'newThisMonth') {
        params.set('filter', status);
      } else if (status === 'newThisMonth') {
        params.set('filter', 'newThisMonth');
      } else {
        params.delete('filter');
      }
      params.delete('search');
      params.set('page', '1');
      window.location.search = params.toString();
    }

    function handleSearch(value) {
      clearTimeout(window._searchTimeout);
      window._searchTimeout = setTimeout(() => {
        const params = new URLSearchParams(window.location.search);
        if (value.trim()) {
          params.set('search', value.trim());
        } else {
          params.delete('search');
        }
        params.set('page', '1');
        window.location.search = params.toString();
      }, 500);
    }

    function exportPDF() {
      const params = new URLSearchParams(window.location.search);
      window.open(`/admin/customers/export?${params.toString()}`, '_blank');
    }

    function viewDetails(id) {
      window.location.href = `/admin/customers/${id}`;
    }
  </script>
</body>
</html>