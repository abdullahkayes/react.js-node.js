<!DOCTYPE html>
<html lang="en" class="h-full bg-[#050c18]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Items & Purchase Preparation - SHP-2602847 - Dazzling Shipping</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              dark: '#050c18', card: '#081225', border: '#1b2b48',
              orange: '#f97316', 'orange-hover': '#ea580c',
              accentBlue: '#38bdf8', accentGreen: '#22c55e',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-[#050c18] text-slate-200 font-sans antialiased overflow-x-hidden">
  <div class="flex min-h-screen w-full">
    <%- include('partials/sidebar', { active: 'assisted-purchase' }) %>
    
    <div class="flex-1 flex flex-col min-w-0">
      <%- include('partials/header', { 
        title: 'Manage Purchase', 
        subtitle: 'Coordinate the approved purchase and follow seller orders', 
        user: typeof user !== 'undefined' ? user : {} 
      }) %>

      <main class="flex-1 p-6 space-y-5 overflow-y-auto">
        <%
          /* ---------------------------------------------------------------------------
           * Items & Purchase Preparation Context & Data Setup
           * ------------------------------------------------------------------------- */
          const shipmentId = (typeof purchase !== 'undefined' && purchase.shipmentId) ? purchase.shipmentId : 'SHP-2602847';
          const subtitle = (typeof purchase !== 'undefined' && purchase.subtitle) ? purchase.subtitle : 'Review submitted products and confirmed purchase costs';

          const purchaseItems = (typeof items !== 'undefined' && Array.isArray(items)) ? items : [
            {
              id: 'ITM-260847-01',
              productName: 'Cotton T-shirt',
              store: 'Amazon',
              category: 'Category A',
              quantity: 20,
              variant: 'Navy / Medium',
              unitPrice: '12.00',
              lineTotal: '240.00',
              acceptance: 'Approved',
              purchased: 'Purchased'
            },
            {
              id: 'ITM-260847-02',
              productName: 'Moisturizing cream',
              store: 'Amazon',
              category: 'Category B',
              quantity: 10,
              variant: 'Fragrance-free / 16 oz',
              unitPrice: '18.00',
              lineTotal: '180.00',
              acceptance: 'Approved',
              purchased: 'Purchased'
            },
            {
              id: 'ITM-260847-03',
              productName: 'Wireless headphones',
              store: 'Walmart',
              category: 'Category D',
              quantity: 4,
              variant: 'Black / Standard',
              unitPrice: '90.00',
              lineTotal: '360.00',
              acceptance: 'Approved',
              purchased: 'Not Purchased',
              selected: true
            },
            {
              id: 'ITM-260847-04',
              productName: 'Running shoes',
              store: 'Walmart',
              category: 'Category A',
              quantity: 2,
              variant: 'Grey / US 9',
              unitPrice: '60.00',
              lineTotal: '120.00',
              acceptance: 'Approved',
              purchased: 'Not Purchased'
            }
          ];

          const selectedItem = purchaseItems.find(i => i.selected) || purchaseItems[2];

          const returnTerms = [
            { id: 'ITM-260847-01', seller: 'Amazon', window: '30 days from delivery', fee: 'None stated', eligibility: 'Subject to seller conditions', consent: 'Recorded' },
            { id: 'ITM-260847-02', seller: 'Amazon', window: '30 days from delivery; unopened', fee: 'None stated', eligibility: 'Unopened product only', consent: 'Recorded' },
            { id: 'ITM-260847-03', seller: 'Walmart', window: '30 days from delivery', fee: 'None stated', eligibility: 'Subject to seller conditions', consent: 'Recorded' },
            { id: 'ITM-260847-04', seller: 'Walmart', window: '30 days from delivery; unworn', fee: 'None stated', eligibility: 'Unworn; original packaging', consent: 'Recorded' }
          ];
        %>

        <!-- Top Breadcrumb & Title Section -->
        <div class="space-y-1">
          <div class="text-[10.5px] text-slate-400 font-medium">
            <a href="/admin/assisted-purchases" class="hover:underline">Assisted Purchase &amp; Procurement</a> 
            <span class="mx-1 text-slate-600">/</span> 
            <span class="text-slate-300">Manage Purchase</span>
          </div>

          <div class="flex items-center gap-3 pt-0.5">
            <h1 class="text-xl font-bold text-white tracking-tight font-mono"><%= shipmentId %></h1>
            <span class="text-slate-400 text-[11px]">• &nbsp;<%= subtitle %> </span>
          </div>
        </div>

        <!-- Section Sub-Tabs Navigation Strip -->
        <div class="border-b border-[#1b2b48] flex items-center gap-6 text-[11.5px] font-medium pt-1">
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Overview</a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/items-purchase-preparation" class="pb-2.5 text-[#f97316] border-b-2 border-[#f97316] font-semibold">Items &amp; Purchase Preparation </a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/invoice-advance-payment" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Invoice &amp; Advance Payment</a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/seller-orders-tracking" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Seller Orders &amp; Tracking</a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/documents" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Documents</a>
          <a href="/admin/assisted-purchase/manage/<%= typeof purchaseId !== 'undefined' ? purchaseId : '' %>/audit-trail" class="pb-2.5 text-slate-400 hover:text-slate-200 transition-colors">Audit Trail</a>
        </div>

        <!-- Purchase Items Panel -->
        <div class="bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-3">
          <div class="flex items-center justify-between border-b border-[#132238] pb-2.5">
            <h2 class="text-sm font-bold text-white">Purchase Items </h2>
            <div class="text-[11px] text-slate-400 font-medium">4 items · product subtotal USD 900.00 </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-[11px]">
              <thead>
                <tr class="border-b border-[#1b2b48] text-slate-400 text-[10px]">
                  <th class="py-2.5 pr-3 font-semibold">Item ID </th>
                  <th class="py-2.5 px-3 font-semibold">Product / Store </th>
                  <th class="py-2.5 px-3 font-semibold">Category </th>
                  <th class="py-2.5 px-3 font-semibold">Quantity </th>
                  <th class="py-2.5 px-3 font-semibold">Color / Size / Variant </th>
                  <th class="py-2.5 px-3 font-semibold">Confirmed Unit Price (USD) </th>
                  <th class="py-2.5 px-3 font-semibold">Line Total (USD) </th>
                  <th class="py-2.5 px-3 font-semibold">Acceptance </th>
                  <th class="py-2.5 px-3 font-semibold">Purchased </th>
                  <th class="py-2.5 pl-3 text-right font-semibold">Action </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#16243d]/60 text-slate-300">
                <% purchaseItems.forEach((item) => { %>
                  <tr class="hover:bg-[#0f1d35]/50 transition-colors <%= item.selected ? 'bg-[#0e1d38]/60 border-l-2 border-[#f97316]' : '' %>">
                    
                    <!-- Item ID -->
                    <td class="py-3.5 pr-3 font-mono font-medium text-blue-400 align-middle">
                      <%= item.id %> 
                    </td>

                    <!-- Product / Store -->
                    <td class="py-3.5 px-3 align-middle">
                      <div class="text-white font-medium"><%= item.productName %> </div>
                      <div class="text-[10px] text-slate-400 mt-0.5"><%= item.store %> </div>
                    </td>

                    <!-- Category -->
                    <td class="py-3.5 px-3 text-slate-300 align-middle">
                      <%= item.category %> 
                    </td>

                    <!-- Quantity -->
                    <td class="py-3.5 px-3 text-slate-200 font-semibold align-middle">
                      <%= item.quantity %> 
                    </td>

                    <!-- Variant -->
                    <td class="py-3.5 px-3 text-slate-300 align-middle">
                      <%= item.variant %> 
                    </td>

                    <!-- Unit Price -->
                    <td class="py-3.5 px-3 font-mono text-slate-200 align-middle">
                      <%= item.unitPrice %> 
                    </td>

                    <!-- Line Total -->
                    <td class="py-3.5 px-3 font-mono font-semibold text-white align-middle">
                      <%= item.lineTotal %> 
                    </td>

                    <!-- Acceptance Badge -->
                    <td class="py-3.5 px-3 align-middle">
                      <span class="px-2.5 py-0.5 rounded bg-[#064e3b]/80 text-[#34d399] border border-[#059669]/40 text-[10px] font-semibold">
                        <%= item.acceptance %> 
                      </span>
                    </td>

                    <!-- Purchased Status Badge -->
                    <td class="py-3.5 px-3 align-middle">
                      <% if (item.purchased === 'Purchased') { %>
                        <span class="px-2.5 py-0.5 rounded bg-[#064e3b]/80 text-[#34d399] border border-[#059669]/40 text-[10px] font-semibold">
                          <%= item.purchased %> 
                        </span>
                      <% } else { %>
                        <span class="px-2.5 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 text-[10px] font-semibold">
                          <%= item.purchased %> 
                        </span>
                      <% } %>
                    </td>

                    <!-- Action Link -->
                    <td class="py-3.5 pl-3 text-right align-middle">
                      <a href="#" class="text-blue-400 hover:underline font-medium text-[11px]">View / Edit </a>
                    </td>

                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Selected Item Details & Purchase Preparation 2-Column Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
          
          <!-- LEFT COLUMN: Selected Item Details (7 Cols) -->
          <div class="lg:col-span-7 bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-4">
            <div class="flex items-center justify-between border-b border-[#132238] pb-2.5">
              <h3 class="text-xs font-bold text-white">Selected Item · <%= selectedItem.id %> </h3>
              <button type="button" class="px-3 py-1 bg-[#12233f] hover:bg-[#182d50] text-slate-200 border border-[#23385d] text-[10.5px] font-semibold rounded transition-colors">
                Edit Item Details 
              </button>
            </div>

            <div class="grid grid-cols-2 gap-y-3 gap-x-4 text-[11px]">
              <div>
                <span class="text-[10px] text-slate-400 block">Product Name </span>
                <span class="text-white mt-0.5 block font-semibold"><%= selectedItem.productName %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Store / Website Name </span>
                <span class="text-slate-200 mt-0.5 block font-medium"><%= selectedItem.store %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Product Category </span>
                <span class="text-slate-200 mt-0.5 block font-medium"><%= selectedItem.category %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Quantity </span>
                <span class="text-slate-200 mt-0.5 block font-medium"><%= selectedItem.quantity %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Color / Size / Variant </span>
                <span class="text-slate-200 mt-0.5 block font-medium"><%= selectedItem.variant %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Estimated Product Price (USD) </span>
                <span class="font-mono text-slate-200 mt-0.5 block font-medium">90.00 </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Product Link (USA Store) </span>
                <a href="#" class="text-blue-400 hover:underline mt-0.5 block font-medium">Open customer’s submitted product link </a>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Cart Screenshot (Optional) </span>
                <a href="#" class="text-blue-400 hover:underline mt-0.5 block font-mono">headphones-cart.png </a>
              </div>
            </div>

            <div class="pt-2 border-t border-[#132238] text-[10px] text-slate-500 italic">
              Customer-submitted information 
            </div>
          </div>

          <!-- RIGHT COLUMN: Purchase Preparation (5 Cols) -->
          <div class="lg:col-span-5 bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-4">
            <div class="flex items-center justify-between border-b border-[#132238] pb-2.5">
              <h3 class="text-xs font-bold text-white">Purchase Preparation </h3>
              <button type="button" class="px-3 py-1 bg-[#12233f] hover:bg-[#182d50] text-slate-200 border border-[#23385d] text-[10.5px] font-semibold rounded transition-colors">
                Edit Purchase Details 
              </button>
            </div>

            <div class="grid grid-cols-2 gap-y-3 gap-x-4 text-[11px]">
              <div>
                <span class="text-[10px] text-slate-400 block">Confirmed Unit Price (USD) </span>
                <span class="font-mono text-white mt-0.5 block font-semibold"><%= selectedItem.unitPrice %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Product Line Total (USD) </span>
                <span class="font-mono text-white mt-0.5 block font-semibold"><%= selectedItem.lineTotal %> </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Availability </span>
                <span class="text-slate-200 mt-0.5 block font-medium">In stock at last check </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block mb-1">Acceptance Review </span>
                <span class="px-2 py-0.5 rounded bg-[#064e3b]/80 text-[#34d399] border border-[#059669]/40 text-[9.5px] font-semibold inline-block">
                  Approved 
                </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Price Checked At </span>
                <span class="text-slate-300 mt-0.5 block">06 Sep 2026, 03:20 PM </span>
              </div>
              <div>
                <span class="text-[10px] text-slate-400 block">Checked By </span>
                <a href="#" class="text-blue-400 hover:underline font-mono mt-0.5 block">STF-260018 </a>
              </div>
            </div>

            <div class="text-right pt-1">
              <a href="#" class="text-blue-400 hover:underline text-[10.5px] font-medium">View Invoice Breakdown </a>
            </div>

            <div class="pt-2 border-t border-[#132238] text-[10px] text-slate-400">
              Recheck current price and availability before purchasing. 
            </div>
          </div>

        </div>

        <!-- Seller Return Terms & Customer Consent Panel -->
        <div class="bg-[#081225] border border-[#1b2b48] rounded-md p-4 space-y-3">
          <div class="border-b border-[#132238] pb-2.5">
            <h3 class="text-xs font-bold text-white">Seller Return Terms &amp; Customer Consent </h3>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-[11px]">
              <thead>
                <tr class="border-b border-[#1b2b48] text-slate-400 text-[10px]">
                  <th class="py-2.5 pr-3 font-semibold">Item ID </th>
                  <th class="py-2.5 px-3 font-semibold">Seller </th>
                  <th class="py-2.5 px-3 font-semibold">Return Window / Conditions </th>
                  <th class="py-2.5 px-3 font-semibold">Restocking Fee </th>
                  <th class="py-2.5 px-3 font-semibold">Return Eligibility </th>
                  <th class="py-2.5 pl-3 text-right font-semibold">Customer Consent </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#16243d]/60 text-slate-300">
                <% returnTerms.forEach((term) => { %>
                  <tr class="hover:bg-[#0f1d35]/50 transition-colors">
                    <td class="py-3 pr-3 font-mono font-medium text-blue-400 align-middle"><%= term.id %> </td>
                    <td class="py-3 px-3 text-white font-medium align-middle"><%= term.seller %> </td>
                    <td class="py-3 px-3 text-slate-300 align-middle"><%= term.window %> </td>
                    <td class="py-3 px-3 text-slate-300 align-middle"><%= term.fee %> </td>
                    <td class="py-3 px-3 text-slate-300 align-middle"><%= term.eligibility %> </td>
                    <td class="py-3 pl-3 text-right align-middle">
                      <span class="px-2.5 py-0.5 rounded bg-[#064e3b]/80 text-[#34d399] border border-[#059669]/40 text-[10px] font-semibold inline-block">
                        <%= term.consent %> 
                      </span>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-[#132238] text-[10.5px] text-slate-400">
            <span>Consent to applicable seller terms and non-refundable procurement/service fees recorded on 06 Sep 2026, 04:10 PM. </span>
            <a href="#" class="text-blue-400 hover:underline font-medium">View Recorded Consent </a>
          </div>
        </div>

        <!-- Developer Reference Footer Box -->
        <div class="bg-[#050c18] border border-dashed border-[#1b2b48] rounded-md p-3.5 text-[11px] text-slate-400 space-y-1">
          <div class="text-slate-300 font-semibold">Developer reference — outside the live tab </div>
          <p class="text-[10.5px] leading-relaxed">
            Seller terms above are illustrative, not verified store policies. Preserve submitted values and log authorized changes. Changes affecting the approved product, variant, quantity, price or terms require the relevant customer agreement and finance review before the affected purchase. Taxes and shipping must not be counted twice across items and seller orders. 
          </p>
        </div>

      </main>
    </div>
  </div>

  <script>
    if (window.lucide) lucide.createIcons();
  </script>
</body>
</html> 