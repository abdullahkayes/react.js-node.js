<%- include('partials/head', { pageTitle: `${row.requestRef} - Request Details - ${type.label}`, active: 'bookings' }) %>

<%- include('partials/header', {
  title: 'Request Details',
  subtitle: 'Review one customer submission and route it to the correct workflow',
  user: typeof user !== 'undefined' ? user : {},
}) %>

<main class="flex-1 overflow-y-auto bg-[#070D18] text-[#94A3B8] text-xs font-sans p-4 md:p-6 min-h-screen" data-request-detail data-request-type="<%= type.key %>" data-request-status="<%= record.status %>">

  <!-- Request reference and current status -->
  <div class="mb-5" data-page-chrome>
    <div class="text-[11px] text-[#64748B] mb-1.5 flex items-center gap-1">
      <span>Requests & Bookings</span>
      <span>/</span>
      <span class="text-[#94A3B8]"><%= type.shortLabel %></span>
      <span>/</span>
      <span class="text-[#94A3B8]">Request Details</span>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-2xl font-bold text-white tracking-tight"><%= row.requestRef %></h1>
      <span class="px-2.5 py-0.5 text-[11px] font-medium rounded-full <%= row.statusBadgeClass || 'bg-[#3B2808] text-[#F59E0B] border border-[#784E0F]' %>" data-request-status-badge>
        <%= record.status %>
      </span>
    </div>

    <p class="text-[11px] text-[#64748B] mt-1">
      <%= type.label %> • submitted <%= fmtDateTime(record.submittedAt || record.createdAt) %>
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
    <!-- Left column: everything read from the request's own data -->
    <div class="lg:col-span-8 space-y-5">
      <%- include('partials/request-detail-sections') %>
    </div>

    <!-- Right column: the decisions on this request -->
    <div class="lg:col-span-4 space-y-5">
      <%- include('partials/request-detail-processing') %>
    </div>
  </div>
</main>

<%- include('partials/request-action-overlay') %>
<%- include('partials/confirm-remove-document') %>
<%- include('partials/request-detail-script') %>
</body>
</html>